{
  "version": 1,
  "defaultActionId": "beiti-web",
  "actions": [
    {
      "id": "beiti-web",
      "name": "贝缇美业",
      "command": "npm_config_cache=/tmp/beiti-npm-cache npm run dev -- --host 0.0.0.0 --ignore-lock",
      "cwd": ".",
      "background": true,
      "source": "agent",
      "readiness": {
        "outputPatterns": ["http://localhost:4321", "ready"],
        "timeoutMs": 60000
      },
      "open": {
        "type": "preview",
        "url": "http://localhost:4321/",
        "urlFromOutput": true
      }
    }
  ]
}
