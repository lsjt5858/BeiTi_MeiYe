---
import { site, loadContent } from "../lib/content";
import { getPageSeo, organizationJsonLd, serializeJsonLd, languageAlternates } from "../lib/seo";
import { localeFromPath, localizedPath, translate } from '../lib/i18n.ts';
import { localizeHtml, localizedStructuredData } from '../lib/localized-html.ts';
import { brandMedia } from "../components/brand-media.mjs";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import "../styles/visuals.css";
interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
  jsonLd?: any;
  home?: boolean;
}
const {
  title,
  description = "贝缇美业，让美，成为日常。探索品牌理念、查看已确认信息，整理适合自己的美业咨询需求。",
  breadcrumbs = [],
  jsonLd,
  home = false,
} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const tr = (text: string) => translate(text, locale);
const pageTitle = tr(title.includes(site.brand) ? title : `${title} | ${site.brand}`).replaceAll(site.brand, tr(site.brand));
const pageDescription = tr(description);
const contentHtml = localizeHtml(await Astro.slots.render('default'), locale);
const alternates = languageAlternates(loadContent(), Astro.url.pathname);
const { canonical, noindex } = getPageSeo(Astro.url.pathname, pageTitle, description);
const ogImage = site.base_url && brandMedia[0].frozen ? new URL(brandMedia[0].src, site.base_url).href : undefined;
const organization = organizationJsonLd();
const structured = [
  ...(Object.keys(organization).length ? [organization] : []),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map(item => localizedStructuredData(item, locale)),
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15211d" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(item => <link rel="alternate" hreflang={item.language} href={item.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr(site.brand)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_CN' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="2560" />
      <meta property="og:image:height" content="1440" />
      <meta property="og:image:alt" content={tr(brandMedia[0].alt)} />
    </>}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <script type="application/ld+json" set:html={serializeJsonLd(structured)}></script>
    <slot name="head" />
  </head>
  <body class:list={[{ "is-home": home }]}>
    <a class="skip-link" href="#main-content">{tr('跳至主要内容')}</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      {breadcrumbs.length > 0 && <nav class="breadcrumbs container" aria-label={tr('面包屑')}><ol>
        {breadcrumbs.map((crumb, index) => <li>
          {crumb.href && index < breadcrumbs.length - 1 ? <a href={localizedPath(crumb.href, locale)}>{tr(crumb.label)}</a> : <span aria-current="page">{tr(crumb.label)}</span>}
        </li>)}
      </ol></nav>}
      <Fragment set:html={contentHtml} />
    </main>
    <SiteFooter />
    <script>
      import { initializeSite } from "../components/site-interactions.mjs";
      import { initializeVisualGalleries } from "../components/visual-interactions.mjs";
      initializeSite();
      initializeVisualGalleries();
    </script>
  </body>
</html>
