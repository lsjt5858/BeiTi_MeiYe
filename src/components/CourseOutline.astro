---
import { getCourseOutline, type TrainingDirection } from '../lib/training.ts';
import { localeFromPath, translate, localizedPath } from '../lib/i18n.ts';
import { getFact } from '../lib/content.ts';
interface Props { direction: TrainingDirection }
const { direction } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const tr = (text: string) => translate(text, locale);
const outline = getCourseOutline(direction);
const nailsManager = direction === 'nails' ? getFact<string>('academy.nails-manager') : undefined;
---
{outline && <section class="course-outline" aria-labelledby={`outline-${direction}`}>
  <header class="course-outline-header">
    <div><p class="eyebrow">COURSE CONTENT</p><h2 id={`outline-${direction}`}>{tr(outline.title)}</h2></div>
  </header>
  {nailsManager && <p class="course-teacher-note">{en ? 'Nail teaching and management: ' : '美甲教学与管理：'}<strong>{tr(nailsManager)}</strong> <a class="text-link" href={localizedPath('/about/', locale)}>{en ? 'Meet the teaching team' : '了解师资'} <span aria-hidden="true">→</span></a></p>}
  <dl class="course-module-list">
    {outline.modules.map((module, i) => <div>
      <dt><span class="course-module-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{tr(module.name)}</dt>
      <dd><ul>{module.topics.map(topic => <li>{tr(topic)}</li>)}</ul></dd>
    </div>)}
  </dl>
  {outline.reference && <div class="course-reference">
    <p class="eyebrow">{en ? `${outline.reference.year} COURSE REFERENCE PRICE` : `${outline.reference.year} 版课程资料价`}</p>
    <p><strong>{tr(outline.reference.name)}</strong><span>{tr(outline.reference.duration)} · ¥{outline.reference.fee}</span></p>
  </div>}
  <p class="course-context">{en ? 'Ask the campus for current class dates, tuition and included materials.' : '当期班期、学费和工具材料请向校区咨询。'}</p>
  <a class="text-link" href={localizedPath('/pricing/', locale)}>{en ? 'Tuition reference and retraining fees' : '查看学费参考与复训费用'} <span aria-hidden="true">→</span></a>
</section>}

<style>
  .course-outline { border-top: 1px solid var(--line); margin-block: 48px; padding-block: clamp(32px, 5vw, 64px); }
  .course-outline-header { margin-bottom: 24px; }
  .course-teacher-note { display: flex; align-items: center; flex-wrap: wrap; column-gap: 12px; margin-block: 16px 24px; }
  h2 { font: 400 clamp(28px, 3.5vw, 46px)/1.35 var(--serif); margin: 0 0 24px; max-width: 15em; text-wrap: balance; }
  .course-module-list { margin-block: 24px 32px; }
  .course-module-list > div { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(24px, 5vw, 80px); border-bottom: 1px solid var(--line); padding-block: 24px; }
  dt { display: flex; align-items: baseline; gap: 20px; font: 400 23px/1.5 var(--serif); }
  .course-module-number { font: 13px/1.5 var(--sans); color: var(--gold-dark); }
  dd { margin: 0; line-height: 1.85; }
  dd ul { display: grid; gap: 8px; margin: 0; padding-left: 1.15em; }
  dd li::marker { color: var(--gold-dark); }
  .course-reference { padding: 24px 28px; background: #eee8db; border-left: 3px solid var(--gold-dark); }
  .course-reference p { margin-block: 8px; }
  .course-reference strong { font-weight: 500; }
  .course-reference span { display: inline-block; margin-inline-start: 20px; font-variant-numeric: tabular-nums; }
  .course-context { color: var(--muted); font-size: 14px; line-height: 1.8; }
  .course-context { margin-top: 20px; }
  @media (max-width: 700px) {
    .course-module-list > div { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .course-reference span { display: block; margin-inline-start: 0; margin-top: 8px; }
  }
</style>
