---
interface Item { q: string; a: string }
interface Props {
  title?: string;
  items: Item[];
  headingId?: string;
  class?: string;
}
const { title = '读完之后，还有疑问？', items, headingId, class: className } = Astro.props;
---
<section class:list={['qa-block', className]} aria-labelledby={headingId}>
  <h2 id={headingId} class="qa-title">{title}</h2>
  <dl class="qa-list">
    {items.map((item) => <div class="qa-row"><dt>{item.q}</dt><dd>{item.a}</dd></div>)}
  </dl>
</section>

<style>
  .qa-block { max-width: 760px; }
  .qa-title { margin: 0 0 1.2rem; font-family: var(--serif); font-size: clamp(24px, 2.8vw, 30px); font-weight: 400; line-height: 1.45; }
  .qa-list { margin: 0; }
  .qa-row { display: grid; grid-template-columns: .8fr 1.2fr; gap: 2rem; padding: 1.15rem 0; border-top: 1px solid var(--line); }
  .qa-row dt { font-weight: 600; line-height: 1.7; }
  .qa-row dd { margin: 0; color: #3f4a44; line-height: 1.9; }
  @media (max-width: 640px) { .qa-row { grid-template-columns: minmax(0, 1fr); gap: .4rem; } }
</style>
