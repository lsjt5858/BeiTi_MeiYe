---
interface Item {
  eyebrow: string;
  title: string;
  body: string;
}
interface Props {
  left: Item;
  right: Item;
  label?: string;
  class?: string;
}
const { left, right, label = '双栏对比', class: className } = Astro.props;
---
<section class:list={['comparison-block', className]} aria-label={label}>
  {[left, right].map((item) => <div class="comparison-column">
    <p class="eyebrow">{item.eyebrow}</p>
    <h3>{item.title}</h3>
    <p>{item.body}</p>
  </div>)}
</section>

<style>
  .comparison-block { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--line); background: #fbf9f3; }
  .comparison-column { padding: clamp(22px, 3vw, 34px); }
  .comparison-column + .comparison-column { border-left: 1px solid var(--line); }
  .comparison-column .eyebrow { margin-bottom: 10px; color: var(--gold-dark); }
  .comparison-column h3 { margin: 0 0 10px; font-family: var(--serif); font-size: clamp(20px, 2.4vw, 26px); font-weight: 400; line-height: 1.5; }
  .comparison-column p:last-child { margin: 0; color: #3f4a44; line-height: 1.9; }
  @media (max-width: 640px) {
    .comparison-block { grid-template-columns: minmax(0, 1fr); }
    .comparison-column + .comparison-column { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
