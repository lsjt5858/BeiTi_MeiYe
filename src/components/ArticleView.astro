---
import InnerPage from '../pages/_shared/InnerPage.astro';
import Callout from './Callout.astro';
import StatusBadge from './StatusBadge.astro';
import { getServices, getLocations, site } from '../lib/content.ts';
import { safeSlug } from '../pages/_shared/values.ts';

type TocItem = { level: 2 | 3; text: string; id: string };
interface RelatedItem { slug: string; title: string; status: string }

export interface ArticleViewData {
  slug: string;
  title: string;
  description: string;
  question: string;
  fact_refs: string[];
  body: string;
  html: string;
  updatedAt?: string;
  updated_at?: string;
}

interface Props {
  article: ArticleViewData;
  pending?: boolean;
  related?: RelatedItem[];
}

function decodeHeadingText(value: string) {
  return value
    .replace(/<[^>]+>/g, '')
    .replace(/&#(\d+);/g, (_, code: string) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-f]+);/gi, (_, code: string) => String.fromCharCode(parseInt(code, 16)))
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function addHeadingIds(html: string) {
  const items: TocItem[] = [];
  let index = 0;
  const output = html.replace(/<h([23])([^>]*)>([\s\S]*?)<\/h\1>/gi, (match, level: string, attrs: string, inner: string) => {
    const text = decodeHeadingText(inner);
    if (!text) return match;
    index += 1;
    const id = `section-${index}`;
    items.push({ level: Number(level) as 2 | 3, text, id });
    const cleanedAttrs = attrs.replace(/\sid=(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '');
    return `<h${level}${cleanedAttrs} id="${id}">${inner}</h${level}>`;
  });
  return { html: output, items };
}

const { article, pending = false, related = [] } = Astro.props;
const updatedAt = article.updatedAt || article.updated_at || '';
const services = getServices().filter((service) => article.fact_refs.includes(service.id));
const locations = getLocations().filter((location) => article.fact_refs.includes(location.id));
const { html: headingHtml, items: toc } = addHeadingIds(article.html);
const htmlWithTables = headingHtml.replace(/<table([^>]*)>([\s\S]*?)<\/table>/gi, '<div class="article-table-scroll"><table$1>$2</table></div>');
const coverMatch = /^\s*<p>(?!<img)([\s\S]*?)<\/p>/i.exec(htmlWithTables);
const coverAnswer = (coverMatch?.[1] ?? article.description).replace(/^\s*(?:<strong>)?先说结论[：:](?:<\/strong>)?\s*/, '');
const articleHtml = coverMatch ? htmlWithTables.slice(coverMatch[0].length) : htmlWithTables;
const readingMinutes = Math.max(2, Math.ceil(article.body.replace(/[#>*_`~\-\[\]()|]/g, '').replace(/\s+/g, '').length / 450));
const jsonLd = pending ? undefined : {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: article.title, description: article.description,
  dateModified: updatedAt,
  publisher: { '@type': 'Organization', name: site.brand },
};
const breadcrumbs = pending
  ? [{ label: '文章与解答', href: '/articles/' }, { label: '草稿预览', href: '/articles/preview/' }, { label: article.title }]
  : [{ label: '文章与解答', href: '/articles/' }, { label: article.title }];
const relatedHref = (item: RelatedItem) => item.status === 'confirmed'
  ? `/articles/${safeSlug(item.slug)}/`
  : `/articles/preview/${safeSlug(item.slug)}/`;
---
<InnerPage title={article.title} eyebrow={pending ? 'Draft preview / 待确认草稿' : 'Journal / 问题解答'} description={article.description} updatedAt={updatedAt} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <div class="article-layout" id="article-top">
    <article class="article-main">
      {pending && <Callout tone="warn" title="待确认草稿，尚未发布">
        <p>这篇内容仍在核对，当前页面只用于内部预览，不构成公开信息，也不代表服务、价格或开班安排已经确认。</p>
      </Callout>}

      <header class="article-cover">
        <p class="eyebrow">这篇文章回答</p>
        <p class="article-cover-question">{article.question}</p>
        <div class="article-cover-answer">
          <p class="eyebrow">先说结论</p>
          <p set:html={coverAnswer} />
        </div>
        <p class="article-cover-meta">
          <StatusBadge status={pending ? 'pending' : 'confirmed'} label={pending ? '待确认草稿' : '已确认内容'} />
          <span>更新于 <time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time> · 约 {readingMinutes} 分钟阅读 · {toc.length} 个章节</span>
        </p>
      </header>

      <div class="article-compare" aria-label="阅读说明">
        <div><p class="eyebrow">这篇会帮你</p><p>建立一个判断框架，知道该问什么、该核对什么。</p></div>
        <div><p class="eyebrow">这篇不替代</p><p>具体服务、价格、地点与预约安排，仍需按已确认信息另行核对。</p></div>
      </div>

      {toc.length > 0 && <details class="article-toc-mobile">
        <summary>文章目录 <span class="toc-count">{toc.length} 节</span></summary>
        <nav aria-label="文章目录">
          <ol class="article-toc-list">
            {toc.map((item) => <li class={`toc-level-${item.level}`}><a href={`#${item.id}`}>{item.text}</a></li>)}
          </ol>
        </nav>
      </details>}

      <div class="prose article-body" set:html={articleHtml} />
    </article>

    <aside class="article-aside" aria-label="文章信息与目录">
      <div class="article-aside-sticky">
        {toc.length > 0 && <nav class="article-toc-desktop" aria-label="文章目录">
          <p class="eyebrow">On this page</p>
          <ol class="article-toc-list">
            {toc.map((item) => <li class={`toc-level-${item.level}`}><a href={`#${item.id}`}>{item.text}</a></li>)}
          </ol>
        </nav>}
        <a class="article-top-link" href="#article-top">回到顶部 ↑</a>
        <button class="article-print" type="button" data-print-article>打印这篇文章</button>
      </div>
    </aside>
  </div>

  <div class="article-footer">
    {related.length > 0 && <section class="article-related" aria-labelledby="article-related-title">
      <h2 class="article-section-title" id="article-related-title">同主题草稿</h2>
      <ul class="article-related-list">
        {related.map((item) => <li>
          <a href={relatedHref(item)}>{item.title}</a>
          <StatusBadge status={item.status === 'confirmed' ? 'confirmed' : 'pending'} label={item.status === 'confirmed' ? '已确认' : '待确认'} />
        </li>)}
      </ul>
    </section>}
    {(services.length > 0 || locations.length > 0) && <section class="editorial-section"><h2>与这篇文章有关的信息</h2><ul class="editorial-list">
      {services.map((service) => <li class="editorial-row"><h3><a class="text-link" href={`/services/${safeSlug(service.slug)}/`}>{service.name}</a></h3><p>查看这项服务已确认的适用范围、限制与计费说明。</p></li>)}
      {locations.map((location) => <li class="editorial-row"><h3><a class="text-link" href={`/locations/${safeSlug(location.slug)}/`}>{location.name}</a></h3><p>查看这个地点已确认的地址与到访说明。</p></li>)}
    </ul></section>}
    <section class="article-qa" aria-labelledby="article-qa-title">
      <h2 class="article-section-title" id="article-qa-title">读完之后，还有疑问？</h2>
      <dl class="article-qa-list">
        <div class="article-qa-row"><dt>这篇文章的结论可以直接照做吗？</dt><dd>可以当作判断框架，但具体服务、价格和安排仍需按已确认信息核对。</dd></div>
        <div class="article-qa-row"><dt>文中的数字是报价吗？</dt><dd>不是。文章解释的是判断方法和需要核对的问题，不构成报价。</dd></div>
        <div class="article-qa-row"><dt>下一步应该做什么？</dt><dd>把目标、预算和最关心的问题整理出来，再通过已确认的联系渠道核对。</dd></div>
      </dl>
    </section>
    <section class="editorial-section"><h2>准备好之后，把问题写下来。</h2><p class="intro-copy">把问题和您已经了解的信息一起写下来。咨询摘要只在本地整理，不发送，也不代替具体服务确认。</p><div class="page-actions"><a class="button" href="/contact/">继续整理问题</a><a class="text-link" href={pending ? '/articles/preview/' : '/articles/'}>{pending ? '返回草稿预览' : '返回全部文章'}</a><button class="text-link article-print" type="button" data-print-article>打印这篇文章</button></div></section>
  </div>
</InnerPage>

<script>
  document.querySelectorAll('[data-print-article]').forEach((button) => {
    button.addEventListener('click', () => window.print());
  });
</script>

<style>
  .article-layout { display: grid; grid-template-columns: minmax(0, 760px) 240px; gap: clamp(36px, 5vw, 72px); max-width: 1080px; margin: 0 auto; }
  .article-main { min-width: 0; }
  .article-footer { max-width: 1080px; margin: 0 auto; }

  .article-cover { margin: 0 0 2.2rem; padding: 1.5rem 1.7rem; border-left: 3px solid var(--gold-dark); background: #f3ecdc; }
  .article-cover .eyebrow { margin-bottom: 10px; color: var(--gold-dark); }
  .article-cover-question { margin: 0 0 1.4rem; font-family: var(--serif); font-size: clamp(18px, 2.1vw, 22px); line-height: 1.8; }
  .article-cover-answer { padding-top: 1.2rem; border-top: 1px solid rgb(127 102 64 / 28%); }
  .article-cover-answer .eyebrow { margin-bottom: 8px; }
  .article-cover-answer p:last-child { margin: 0; font-size: 17px; line-height: 1.9; }
  .article-cover-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 1.2rem 0 0; color: var(--muted); font-size: 13px; letter-spacing: .04em; line-height: 1.7; }
  .article-compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 0 2.4rem; border: 1px solid var(--line); background: #fbf9f3; }
  .article-compare > div { padding: 1.2rem 1.4rem; }
  .article-compare > div + div { border-left: 1px solid var(--line); }
  .article-compare .eyebrow { margin-bottom: 8px; color: var(--gold-dark); }
  .article-compare p:last-child { margin: 0; font-size: 15px; line-height: 1.85; color: #3f4a44; }

  .article-body { max-width: 760px; font-size: 16px; line-height: 1.95; color: var(--ink); }
  .article-body :global(p) { margin: 0 0 1.15rem; }
  .article-body :global(p:last-child) { margin-bottom: 0; }
  .article-body :global(h2), .article-main .article-body :global(h2) { position: relative; margin: 3.2rem 0 1.25rem; padding: 1.55rem 0 0 1.15rem; border-top: 1px solid var(--line); font-family: var(--serif); font-size: clamp(26px, 3vw, 34px); font-weight: 400; line-height: 1.45; letter-spacing: .02em; color: var(--ink); }
  .article-body :global(h2::before) { content: ""; position: absolute; left: 0; top: 1.7rem; width: 4px; height: 1.1em; background: var(--gold); }
  .article-body :global(h3), .article-main .article-body :global(h3) { margin: 2.2rem 0 .85rem; font-family: var(--sans); font-size: 19px; font-weight: 600; line-height: 1.6; letter-spacing: .02em; color: var(--ink); }
  .article-body :global(h3::before) { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 10px; background: var(--gold-dark); vertical-align: middle; }
  .article-body :global(h4) { margin: 1.8rem 0 .7rem; font-size: 16px; font-weight: 600; }
  .article-body :global(strong) { font-weight: 600; background: linear-gradient(transparent 62%, rgb(220 200 166 / 52%) 62%); }
  .article-body :global(em) { color: var(--gold-dark); }
  .article-body :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--gold-dark); text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .article-body :global(a:hover) { color: var(--gold-dark); }
  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 1.4rem; padding-left: 1.4rem; }
  .article-body :global(li) { margin: .45rem 0; padding-left: .2rem; }
  .article-body :global(li::marker) { color: var(--gold-dark); }
  .article-body :global(ul ul), .article-body :global(ul ol), .article-body :global(ol ul), .article-body :global(ol ol) { margin-top: .4rem; margin-bottom: .4rem; }
  .article-body :global(blockquote) { margin: 2rem 0; padding: 1.25rem 1.5rem; border-left: 3px solid var(--gold-dark); background: #f3ecdc; color: #3f4a44; }
  .article-body :global(blockquote p) { margin: 0; font-family: var(--serif); font-size: 17px; line-height: 1.9; }
  .article-body :global(.article-table-scroll) { overflow-x: auto; margin: 1.8rem 0 2rem; border: 1px solid var(--line); background: #fbf9f3; -webkit-overflow-scrolling: touch; }
  .article-body :global(.article-table-scroll table) { width: 100%; min-width: 36rem; border-collapse: separate; border-spacing: 0; font-size: 14.5px; line-height: 1.7; }
  .article-body :global(thead th) { padding: 12px 14px; background: #e9e4d6; border-bottom: 1px solid var(--line); font-weight: 600; text-align: left; white-space: nowrap; }
  .article-body :global(td) { padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; font-variant-numeric: tabular-nums; }
  .article-body :global(tbody tr:nth-child(even)) { background: rgb(238 234 223 / 55%); }
  .article-body :global(tbody tr:last-child td) { border-bottom: 0; }
  .article-body :global(img) { display: block; width: 100%; height: auto; margin: 2rem 0 1.4rem; border: 1px solid var(--line); background: var(--paper); }
  .article-body :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
  .article-body :global(code) { padding: 2px 6px; border: 1px solid var(--line); background: var(--paper); font-size: .9em; }
  .article-body :global(pre) { overflow-x: auto; padding: 1.2rem; background: var(--ink-deep); color: var(--cream); }
  .article-body :global(pre code) { padding: 0; border: 0; background: transparent; color: inherit; }

  .article-aside { align-self: stretch; min-width: 0; }
  .article-aside-sticky { position: sticky; top: calc(var(--header-height) + 28px); max-height: calc(100vh - var(--header-height) - 56px); overflow-y: auto; padding-right: 6px; }
  .article-toc-desktop .eyebrow { margin-bottom: 14px; }
  .article-toc-list { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .article-toc-list li { margin: 0; }
  .article-toc-list a { display: block; padding: 7px 0 7px 14px; margin-left: -1px; border-left: 2px solid transparent; color: var(--muted); font-size: 14px; line-height: 1.6; text-decoration: none; }
  .article-toc-list a:hover { color: var(--ink); border-left-color: var(--gold); }
  .article-toc-list .toc-level-3 a { padding-left: 28px; color: #59635c; }
  .article-top-link { display: inline-block; margin-top: 24px; color: var(--muted); font-size: 13px; text-decoration: underline; text-underline-offset: 4px; }
  .article-print { display: block; margin-top: 14px; padding: 0; border: 0; background: none; color: var(--muted); font: inherit; font-size: 13px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .article-print:hover { color: var(--ink); }
  .page-actions .article-print { display: inline-flex; align-items: center; margin-top: 0; }

  .article-related { max-width: 760px; margin: 0 0 2.5rem; padding-top: 2.2rem; border-top: 1px solid var(--line); }
  .article-related-list { list-style: none; margin: 0; padding: 0; }
  .article-related-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: .8rem 0; border-top: 1px solid var(--line); }
  .article-related-list a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--gold-dark); text-underline-offset: 4px; }
  .article-related-list a:hover { color: var(--gold-dark); }

  .article-qa { max-width: 760px; margin: 0; padding: 2.5rem 0 0; border-top: 1px solid var(--line); }
  .article-section-title { margin: 0 0 1.2rem; font-family: var(--serif); font-size: clamp(24px, 2.8vw, 30px); font-weight: 400; line-height: 1.45; }
  .article-qa-list { margin: 0; }
  .article-qa-row { display: grid; grid-template-columns: .8fr 1.2fr; gap: 2rem; padding: 1.15rem 0; border-top: 1px solid var(--line); }
  .article-qa-row dt { font-weight: 600; line-height: 1.7; }
  .article-qa-row dd { margin: 0; color: #3f4a44; line-height: 1.9; }

  .article-toc-mobile { display: none; margin: 0 0 2rem; border: 1px solid var(--line); background: #fbf9f3; }
  .article-toc-mobile summary { display: flex; align-items: baseline; gap: 10px; padding: 16px 18px; cursor: pointer; list-style: none; font-size: 15px; font-weight: 600; letter-spacing: .04em; }
  .article-toc-mobile summary::-webkit-details-marker { display: none; }
  .article-toc-mobile summary::after { content: "+"; margin-left: auto; color: var(--gold-dark); font-size: 18px; line-height: 1; }
  .article-toc-mobile[open] summary::after { content: "−"; }
  .article-toc-mobile .toc-count { color: var(--muted); font-size: 13px; font-weight: 400; letter-spacing: .04em; }
  .article-toc-mobile nav { padding: 0 18px 16px; }

  @media (max-width: 980px) {
    .article-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .article-aside { display: none; }
    .article-toc-mobile { display: block; }
  }
  @media (max-width: 640px) {
    .article-cover { padding: 1.1rem 1.2rem; }
    .article-compare { grid-template-columns: minmax(0, 1fr); }
    .article-compare > div + div { border-left: 0; border-top: 1px solid var(--line); }
    .article-body { font-size: 15.5px; line-height: 1.9; }
    .article-body :global(h2) { margin-top: 2.6rem; font-size: 26px; }
    .article-body :global(h3) { font-size: 18px; }
    .article-qa-row { grid-template-columns: minmax(0, 1fr); gap: .4rem; }
  }

  @media print {
    :global(body) { padding-top: 0 !important; background: #fff !important; color: #000 !important; }
    :global(.site-header), :global(.site-footer), :global(.breadcrumbs), :global(.page-update), :global(.skip-link), :global(.mobile-menu) { display: none !important; }
    :global(.page-header) { padding: 0 0 14pt !important; }
    :global(.page-header h1) { font-size: 22pt !important; }
    :global(.page-description) { color: #333 !important; font-size: 10.5pt !important; }
    .article-layout { display: block; max-width: none; }
    .article-aside, .article-toc-mobile, .article-print, .article-related, .article-footer .page-actions { display: none !important; }
    .article-main, .article-body, .article-qa { max-width: none; }
    .article-cover, .article-compare, .article-qa { break-inside: avoid; background: #f4f4f4 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .article-compare { display: grid; grid-template-columns: 1fr 1fr; }
    .article-qa-row { grid-template-columns: .8fr 1.2fr; }
    .article-body { font-size: 10.5pt; line-height: 1.65; }
    .article-body :global(h2) { margin: 16pt 0 8pt; padding-top: 8pt; border-top: 1px solid #999; font-size: 15pt; break-after: avoid; }
    .article-body :global(h3) { margin: 12pt 0 6pt; font-size: 11.5pt; break-after: avoid; }
    .article-body :global(h2::before), .article-body :global(h3::before) { display: none; }
    .article-body :global(a) { color: #000; text-decoration: underline; }
    .article-body :global(.article-table-scroll) { overflow: visible; border: 1px solid #999; }
    .article-body :global(table) { min-width: 0; font-size: 8.5pt; }
    .article-body :global(thead th) { background: #eee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .article-body :global(img) { max-width: 65%; margin: 10pt auto; break-inside: avoid; }
    .article-body :global(blockquote) { break-inside: avoid; background: #f4f4f4 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    @page { margin: 16mm; }
  }
</style>
