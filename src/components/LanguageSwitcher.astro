---
import { site, loadContent } from '../lib/content.ts';
import { contentPaths } from '../lib/seo.ts';
import { localeFromPath, localizedPath, sourcePath } from '../lib/i18n.ts';
const current = Astro.url.pathname;
const locale = localeFromPath(current);
const generated = contentPaths(loadContent());
const target = sourcePath(current) === '/404/' ? '/404/' : generated.includes(sourcePath(current)) ? sourcePath(current) : '/';
---
{site.languages?.includes('en') && <details class="language-switcher" data-language-switcher>
  <summary aria-label={locale === 'en' ? 'Choose language' : '切换语言'} aria-expanded="false" aria-controls="language-options">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor"/><ellipse cx="12" cy="12" rx="4" ry="9" stroke="currentColor"/><path d="M3 12h18" stroke="currentColor"/></svg>
    <span>{locale === 'en' ? 'EN' : '中文'}</span>
    <svg class="language-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2 4 4 4 4-4" stroke="currentColor"/></svg>
  </summary>
  <nav id="language-options" aria-label={locale === 'en' ? 'Languages' : '语言选项'}>
    <p class="language-heading">{locale === 'en' ? 'LANGUAGE' : '选择语言'}</p>
    <a href={localizedPath(target, 'zh-CN')} lang="zh-CN" hreflang="zh-CN" data-language-link="zh-CN" aria-current={locale === 'zh-CN' ? 'true' : undefined}><span>简体中文<small>CHINESE</small></span>{locale === 'zh-CN' && <span aria-hidden="true">✓</span>}</a>
    <a href={localizedPath(target, 'en')} lang="en" hreflang="en" data-language-link="en" aria-current={locale === 'en' ? 'true' : undefined}><span>English<small>ENGLISH</small></span>{locale === 'en' && <span aria-hidden="true">✓</span>}</a>
    {target === '/contact/' && <p class="language-note">{locale === 'en' ? 'Copy your inquiry before switching.' : '切换前请先复制已填写的咨询内容。'}</p>}
  </nav>
</details>}
<script>
  const picker = document.querySelector<HTMLDetailsElement>('[data-language-switcher]');
  if (picker) {
    const summary = picker.querySelector('summary');
    picker.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(picker.open));
      const mobile = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      if (picker.open && mobile) mobile.open = false;
    });
    picker.addEventListener('keydown', event => {
      if (event.key === 'Escape') { picker.open = false; summary?.focus(); }
    });
    document.addEventListener('pointerdown', event => {
      if (picker.open && event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
    });
    picker.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach(link => {
      const url = new URL(link.href);
      // Preserve topic codes and anchors, never put form values into a URL or persistent storage.
      const interest = new URLSearchParams(location.search).get('interest');
      if (targetIsContact(url.pathname) && ['nails', 'lashes', 'management', 'video', 'learning'].includes(interest ?? '')) url.searchParams.set('interest', interest!);
      if (location.hash && document.getElementById(location.hash.slice(1))) url.hash = location.hash;
      link.href = `${url.pathname}${url.search}${url.hash}`;
    });
    const mobile = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
    mobile?.addEventListener('toggle', () => { if (mobile.open) picker.open = false; });
  }
  function targetIsContact(path: string) { return /\/contact\/$/.test(path); }
</script>
