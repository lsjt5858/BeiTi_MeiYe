---
import { getLatestUpdate, getReviews, site } from "../lib/content";
const updated = getLatestUpdate();
const date = updated && Number.isFinite(Date.parse(updated)) ? new Date(updated).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="footer-brand-name">{site.brand}</a>
      <p class="footer-tagline">让美，成为日常。</p>
      <p class="footer-wordmark" aria-hidden="true">BEITI BEAUTY</p>
    </div>
    <nav class="footer-links" aria-label="页脚导航">
      <a href="/services/">探索美业</a>
      <a href="/pricing/">价格信息</a>
      <a href="/about/">品牌理念</a>
      <a href="/locations/">地点信息</a>
      <a href="/articles/">美学手记</a>
      <a href="/faq/">常见问题</a>
      {getReviews().length > 0 && <a href="/reviews/">授权评价</a>}
      <a href="/contact/">整理咨询需求 <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.brand}</p>
    <p>{updated ? "内容更新" : "页面生成"}：<time datetime={date}>{date}</time></p>
    <nav aria-label="法律信息"><a href="/privacy/">隐私说明</a><a href="/terms/">使用条款</a></nav>
  </div>
  <div class="container privacy-control">
    <button
      class="analytics-toggle"
      type="button"
      data-analytics-toggle
      data-environment={site.environment}
      data-base-url={site.base_url}
      data-endpoint={site.analytics_endpoint}
      aria-pressed="false"
      aria-describedby="analytics-status"
      disabled
    >开启访问分析</button>
    <span id="analytics-status" data-analytics-status aria-live="polite">默认关闭，不发送访问数据。</span>
  </div>
</footer>
