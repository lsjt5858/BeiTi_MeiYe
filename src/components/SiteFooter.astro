---
import { getReviews, getLocations, getContactPhone, getFact, site } from "../lib/content";
import { localeFromPath, localizedPath, translate } from '../lib/i18n.ts';
import { getSocialChannels } from '../lib/social.ts';
import SocialLogo from './SocialLogo.astro';
const locale = localeFromPath(Astro.url.pathname);
const tr = (text: string) => translate(text, locale);
const href = (path: string) => localizedPath(path, locale);
const year = new Date().getFullYear();
const socialChannels = getSocialChannels();
const campus = getLocations()[0];
const campusMapUrl = campus?.address
  ? `https://api.map.baidu.com/geocoder?${new URLSearchParams({ address: campus.address, output: 'html', src: 'webapp.beitimeiye' })}`
  : undefined;
const mapLabel = locale === 'en' ? 'View address in Baidu Maps (opens in a new tab)' : '在百度地图查看（新窗口打开）';
const amapUrl = campus?.address
  ? `https://uri.amap.com/search?${new URLSearchParams({ keyword: campus.address, city: '杭州市', view: 'map', src: 'beitimeiye', callnative: '0' })}`
  : undefined;
const { display: phone, tel } = getContactPhone();
const wechatFact = getFact('contact.wechat');
const wechat = typeof wechatFact === 'string' ? wechatFact : undefined;
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href={href('/')} class="footer-brand-name">{tr(site.brand)}</a>
      <p class="footer-tagline">{tr('让美，成为日常。')}</p>
      <p class="footer-wordmark" aria-hidden="true">BEITI BEAUTY</p>
      {campus && <address class="footer-nap">
        <span>{tr(campus.name)}</span>
        {campusMapUrl ? <a href={campusMapUrl} target="_blank" rel="noopener noreferrer" title={mapLabel} aria-label={`${tr(campus.address)} · ${mapLabel}`}>{tr(campus.address)} <span aria-hidden="true">↗</span></a> : <span>{tr(campus.address)}</span>}
        {phone && <span>{tr('咨询电话：')}{tel ? <a href={`tel:${tel}`}>{phone}</a> : <span>{phone}</span>}</span>}
        {wechat && <span>{tr('微信：')}{wechat}</span>}
      </address>}
      <nav id="social-profiles" class="footer-social" aria-label={tr('关注贝缇')}>
        <ul class="social-icon-list">
          {socialChannels.map(channel => {
            const campusMap = channel.id === 'amap' ? amapUrl : undefined;
            const label = channel.id === 'amap' && locale === 'en' ? 'Amap' : tr(channel.name);
            const destination = campusMap ? (locale === 'en' ? 'Campus map' : '校区地图') : tr(channel.url ? '账号主页' : '平台官网');
            return <li>
            <a class:list={['social-icon-link', { 'is-external': !channel.url && !campusMap }]} href={campusMap ?? channel.url ?? channel.officialUrl} target="_blank" rel="noopener noreferrer" aria-label={`${label} · ${destination}${tr('（新窗口打开）')}`} title={`${label} · ${destination}`}>
              <SocialLogo platform={channel.id} />
            </a>
          </li>; })}
        </ul>
      </nav>
    </div>
    <nav class="footer-links" aria-label={tr('页脚导航')}>
      <a href={href('/services/')}>{tr('探索美业')}</a>
      <a href={href('/training/')}>{tr('美业培训')}</a>
      <a href={href('/gallery/')}>{tr('美学图鉴')}</a>
      <a href={href('/pricing/')}>{tr('价格信息')}</a>
      <a href={href('/about/')}>{tr('品牌理念')}</a>
      <a href={href('/locations/')}>{tr('地点信息')}</a>
      <a href={href('/articles/')}>{tr('美学手记')}</a>
      <a href={href('/faq/')}>{tr('咨询前须知')}</a>
      {getReviews().length > 0 && <a href={href('/reviews/')}>{tr('授权评价')}</a>}
      <a href={href('/contact/')}>{tr('整理咨询需求')} <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {tr(site.brand)}</p>
    <nav aria-label={tr('法律信息')}><a href={href('/privacy/')}>{tr('隐私说明')}</a><a href={href('/terms/')}>{tr('使用条款')}</a></nav>
  </div>
</footer>
