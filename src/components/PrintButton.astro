---
interface Props {
  label?: string;
  class?: string;
}
const { label = '打印这篇文章', class: className } = Astro.props;
---
<button class:list={['print-button', className]} type="button" data-print-page>{label}</button>

<script>
  if (!document.documentElement.dataset.printBound) {
    document.documentElement.dataset.printBound = 'true';
    document.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-print-page]')) window.print();
    });
  }
</script>

<style>
  .print-button { display: inline-flex; align-items: center; padding: 0; border: 0; background: none; color: var(--muted); font: inherit; font-size: 13px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .print-button:hover { color: var(--ink); }
  @media print { .print-button { display: none !important; } }
</style>
