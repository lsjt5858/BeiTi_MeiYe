---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getLatestUpdate } from '../../lib/content.ts';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  breadcrumbs?: { label: string; href?: string }[];
  jsonLd?: unknown;
  updatedAt?: string;
}
const { title, description, eyebrow, breadcrumbs, jsonLd, updatedAt = getLatestUpdate() } = Astro.props;
---
<SiteLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <PageHeader title={title} description={description} eyebrow={eyebrow} />
  <div class="container page-body">
    <slot />
    {updatedAt && <p class="meta page-update">内容最近更新：<time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time></p>}
  </div>
</SiteLayout>

<style>
  .page-body { padding-bottom: clamp(4rem, 8vw, 8rem); }
  .page-update { margin-top: 4rem; border-top: 1px solid var(--line, #d9d1c4); padding-top: 1.5rem; }
  .page-body :global(.editorial-section) { padding-block: clamp(2.5rem, 5vw, 4.5rem); border-top: 1px solid var(--line, #d9d1c4); }
  .page-body :global(.editorial-section:first-child) { padding-top: 1rem; border-top: 0; }
  .page-body :global(h2) { font-size: clamp(1.7rem, 3.5vw, 2.8rem); line-height: 1.3; margin: 0 0 1.5rem; font-weight: 400; }
  .page-body :global(h3) { font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.45; font-weight: 500; }
  .page-body :global(.intro-copy) { max-width: 46rem; font-size: clamp(1.05rem, 1.7vw, 1.25rem); line-height: 1.9; }
  .page-body :global(.editorial-list) { list-style: none; padding: 0; margin: 0; }
  .page-body :global(.editorial-row) { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); column-gap: clamp(2rem, 5vw, 6rem); border-top: 1px solid var(--line, #d9d1c4); padding-block: 2rem; }
  .page-body :global(.editorial-row h3) { margin-top: 0; }
  .page-body :global(.editorial-row p) { max-width: 44rem; line-height: 1.9; }
  .page-body :global(.row-number) { display: block; font-size: .78rem; letter-spacing: .12em; margin-bottom: 1.1rem; color: var(--muted, #686258); }
  .page-body :global(.empty-editorial) { padding-block: clamp(2rem, 5vw, 4rem); max-width: 46rem; }
  .page-body :global(.empty-editorial p) { line-height: 1.9; margin-bottom: 2rem; }
  .page-body :global(.fact-table) { width: 100%; border-collapse: collapse; text-align: left; line-height: 1.8; }
  .page-body :global(.fact-table th), .page-body :global(.fact-table td) { padding: 1.15rem .8rem 1.15rem 0; border-bottom: 1px solid var(--line, #d9d1c4); vertical-align: top; overflow-wrap: anywhere; }
  .page-body :global(.fact-table th) { font-weight: 500; }
  .page-body :global(.table-scroll) { overflow-x: auto; }
  .page-body :global(.fact-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 4rem; }
  .page-body :global(.fact-grid dt) { color: var(--muted, #686258); font-size: .9rem; margin-bottom: .6rem; }
  .page-body :global(.fact-grid dd) { margin: 0; line-height: 1.9; overflow-wrap: anywhere; }
  .page-body :global(.fact-list) { padding-left: 1.3rem; line-height: 2; }
  .page-body :global(.page-actions) { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 2rem; }
  .page-body :global(.small-note) { color: var(--muted, #686258); font-size: .9rem; line-height: 1.8; }
  .page-body :global(.quote-text) { margin: 0 0 1rem; font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.9; }
  .page-body :global(a) { overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    .page-body :global(.editorial-row), .page-body :global(.fact-grid) { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  }
</style>
