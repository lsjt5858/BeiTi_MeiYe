---
import InnerPage from '../_shared/InnerPage.astro';
import { getLocations, getArticles, getContactPhone } from '../../lib/content.ts';
import { safeSlug, safeHttpUrl, formatValue } from '../_shared/values.ts';
import { localeFromPath } from '../../lib/i18n.ts';
export function getStaticPaths() {
  return getLocations().map((location) => ({ params: { slug: safeSlug(location.slug) }, props: { location } }));
}
type Location = ReturnType<typeof getLocations>[number];
interface Props { location: Location }
const { location } = Astro.props;
const en = localeFromPath(Astro.url.pathname) === 'en';
const mapUrl = safeHttpUrl(location.mapUrl);
const address = formatValue(location.address);
const transport = formatValue(location.transport);
const hours = formatValue(location.hours);
const booking = formatValue(location.booking);
const { display: phone, tel } = getContactPhone();
const description = address
  ? `${location.name}在${address}，${transport || '按地址导航'}。`
  : `${location.name}的具体地址尚未公开。请在地址与时间确认前不要出发。`;
const jsonLd = address ? {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: location.name,
  address, ...(tel ? { telephone: phone } : {}), ...(mapUrl ? { hasMap: mapUrl } : {}),
} : undefined;
const articles = getArticles().filter((article) => article.fact_refs.includes(location.id));
---
<InnerPage title={location.name} eyebrow="Campus / 校区" description={description} updatedAt={location.updatedAt} jsonLd={jsonLd} breadcrumbs={[{ label: '地点信息', href: '/locations/' }, { label: location.name }]}>
  <section class="editorial-section">
    <h2>到访前，先看这几项。</h2>
    <dl class="fact-grid">
      <div><dt>地址</dt><dd>{address || '尚未公开确认'}</dd></div>
      <div><dt>地铁</dt><dd>{transport || '尚未公开确认'}</dd></div>
      {phone && <div><dt>咨询电话</dt><dd>{tel ? <a class="text-link" href={`tel:${tel}`}>{phone}</a> : <span>{phone}</span>}</dd></div>}
      {hours && <div><dt>开放时间</dt><dd>{hours}</dd></div>}
      <div><dt>到访安排</dt><dd>{booking || '出发前请先电话确认当天安排。'}</dd></div>
    </dl>
    <div class="page-actions">
      {tel && phone ? <a class="button" href={`tel:${tel}`}>打电话 {phone}</a> : <a class="button" href="/contact/">整理到访问题</a>}
      <a class="text-link" href="/contact/">先把问题写下来</a>
    </div>
  </section>
  {mapUrl && <section class="editorial-section"><h2>地图</h2><div class="page-actions"><a class="button-secondary" href={mapUrl} target="_blank" rel="noopener noreferrer">打开地图导航（新窗口）</a></div><p class="small-note">将进入第三方网站，请留意对方的隐私说明。</p></section>}
  {articles.length > 0 && <section class="editorial-section"><h2>相关信息</h2><ul class="editorial-list">{articles.map((article) => <li class="editorial-row"><h3><a class="text-link" href={`/articles/${safeSlug(article.slug)}/`}>{article.title}</a></h3><p>{article.description}</p></li>)}</ul></section>}
  <section class="editorial-section"><h2>{en ? 'Arrange a visit' : '来校区看看'}</h2><p class="intro-copy">{en ? 'Message us on WeChat at hzbeiti with the course you are interested in and a convenient visiting time.' : '微信 hzbeiti，告诉我们想了解的课程和方便到访的时间。'}</p><div class="page-actions"><a class="button" href="/contact/">整理到访问题</a><a class="text-link" href="/locations/">返回地点信息</a></div></section>
</InnerPage>
