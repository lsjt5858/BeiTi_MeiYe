---
import InnerPage from '../_shared/InnerPage.astro';
import { getLocations, getContactPhone } from '../../lib/content.ts';
import { safeSlug, formatValue } from '../_shared/values.ts';
import { localeFromPath } from '../../lib/i18n.ts';
const en = localeFromPath(Astro.url.pathname) === 'en';
const locations = getLocations();
const { display: phone, tel } = getContactPhone();
const description = locations.length
  ? (en ? 'Hangzhou campus: Building 16, 29 Xingye Street, Gongshu District. Metro Line 4, Huazhong South Road Station, Exit E.' : '杭州拱墅校区，兴业街29号金通数字经济科创园16幢。地铁4号线华中南路站E口。')
  : '目前没有可公开的地点。请不要根据品牌影像推断校区地址。';
---
<InnerPage title="到这里来。" eyebrow="Locations / 校区地址" description={description} breadcrumbs={[{ label: '地点信息' }]}>
  <section class="editorial-section">
    {locations.length ? <>
      <h2>杭州校区</h2>
      <ol class="editorial-list">
        {locations.map((location, index) => <li class="editorial-row">
          <div><span class="row-number">{String(index + 1).padStart(2, '0')}</span><h3><a class="text-link" href={`/locations/${safeSlug(location.slug)}/`}>{location.name}</a></h3></div>
          <div>
            <p>{formatValue(location.address)}</p>
            {formatValue(location.transport) && <p class="meta">交通：{formatValue(location.transport)}</p>}
            {phone && <p class="meta">咨询电话：{tel ? <a class="text-link" href={`tel:${tel}`}>{phone}</a> : <span>{phone}</span>}</p>}
            <a class="text-link" href={`/locations/${safeSlug(location.slug)}/`}>查看到访信息 <span aria-hidden="true">→</span></a>
          </div>
        </li>)}
      </ol>
    </> : <div class="empty-editorial empty-state"><p class="eyebrow">Before your visit</p><h2>一次安心到访，<br />从信息确认开始。</h2><p>地址、交通方式与到访规则将在确认后公开。现在您可以先写下希望到访的时间段，以及需要了解的事项。</p><a class="button" href="/contact/">整理到访相关问题</a></div>}
  </section>
  <section class="editorial-section">
    <h2>{en ? 'Arrange a visit' : '来校区看看'}</h2>
    <p class="intro-copy">{en ? 'Message us on WeChat at hzbeiti with the course you are interested in and a convenient visiting time.' : '微信 hzbeiti，告诉我们想了解的课程和方便到访的时间。'}</p>
    <div class="page-actions">{tel ? <a class="button" href={`tel:${tel}`}>打电话 {phone}</a> : <a class="button" href="/contact/">整理到访问题</a>}<a class="text-link" href="/contact/">先把问题写下来</a></div>
  </section>
</InnerPage>
