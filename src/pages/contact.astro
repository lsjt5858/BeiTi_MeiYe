---
import InnerPage from './_shared/InnerPage.astro';
import { getFact } from '../lib/content.ts';
import { INQUIRY_INTERESTS, INQUIRY_LIMITS, INQUIRY_EMAIL_PATTERN } from '../lib/contact.ts';
const phoneFact = getFact('contact.phone');
const emailFact = getFact('contact.email');
const phone = typeof phoneFact === 'string' && /^\+?[\d ()-]+$/.test(phoneFact)
  && phoneFact.replace(/\D/g, '').length >= 7 && phoneFact.replace(/\D/g, '').length <= 15 ? phoneFact : undefined;
const email = typeof emailFact === 'string' && INQUIRY_EMAIL_PATTERN.test(emailFact)
  && !/[\u0000-\u001f\u007f]/.test(emailFact) ? emailFact : undefined;
const hasChannel = !!(phone || email);
---
<InnerPage title="把想了解的，说清楚。" eyebrow="Contact / 咨询需求整理" description="这里可以在本地整理您的咨询需求。填写、复制与下载都不会发送信息，也不会创建预约；正式沟通需要由您通过已确认的联系渠道另行完成。" breadcrumbs={[{ label: '咨询需求整理' }]}>
  <section class="editorial-section contact-grid">
    <div>
      <h2 id="contact-heading">先整理，不急着决定。</h2>
      <p class="form-intro">所有字段均需填写。请只提供沟通所需的信息，不填写身份证号、支付资料或详细健康记录。</p>
      <div id="contact-errors" class="error-summary" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"><p id="contact-error-summary"></p><ul id="contact-error-list" hidden></ul></div>
      <form id="contact-form" method="post" action="/contact/" autocomplete="off" novalidate data-local-only aria-labelledby="contact-heading">
        <fieldset id="contact-fields" disabled>
          <legend class="sr-only">本地咨询需求填写</legend>
          <div class="field-pair">
            <div class="form-field">
              <label for="contact-name">您的称呼 <span class="field-required">必填</span></label>
              <input id="contact-name" name="name" type="text" required maxlength={INQUIRY_LIMITS.name} autocomplete="off" aria-describedby="name-help name-error" />
              <p id="name-help" class="field-help">可以用昵称，最多 40 个字符。</p><p id="name-error" class="field-error"></p>
            </div>
            <div class="form-field">
              <label for="contact-contact">手机号码 <span class="field-required">必填</span></label>
              <input id="contact-contact" name="contact" type="tel" inputmode="numeric" pattern="[0-9]{11}" required minlength={INQUIRY_LIMITS.contact} maxlength={INQUIRY_LIMITS.contact} autocomplete="off" aria-describedby="contact-help contact-error" />
              <p id="contact-help" class="field-help">仅限 11 位数字；输入或粘贴均不接受其他字符。</p><p id="contact-error" class="field-error"></p>
            </div>
          </div>
          <div class="form-field">
            <label for="contact-interest">咨询意向 <span class="field-required">必填</span></label>
            <select id="contact-interest" name="interest" required aria-describedby="interest-help interest-error"><option value="">请选择您想了解的方向</option>{INQUIRY_INTERESTS.map((interest) => <option value={interest}>{interest}</option>)}</select>
            <p id="interest-help" class="field-help">这些是您希望了解的方向，不是已开设服务的清单。</p><p id="interest-error" class="field-error"></p>
          </div>
          <div class="form-field">
            <label for="contact-message">您想了解的问题 <span class="field-required">必填</span></label>
            <textarea id="contact-message" name="message" rows="6" required maxlength={INQUIRY_LIMITS.message} aria-describedby="message-help message-count message-error"></textarea>
            <div class="message-help-row"><p id="message-help" class="field-help">可以说明期待、时间安排，以及需要核实的条件或费用。</p><p id="message-count" class="field-help">0 / 1200</p></div><p id="message-error" class="field-error"></p>
          </div>
          <div class="consent-field">
            <input id="contact-consent" name="privacy" type="checkbox" required aria-describedby="privacy-error" />
            <label for="contact-consent">我已阅读<a class="text-link" href="/privacy/">隐私说明</a>，同意仅在当前浏览器内校验和整理我填写的信息。</label>
          </div>
          <p id="privacy-error" class="field-error"></p>
          <div hidden aria-hidden="true"><label for="contact-website">请保持此项为空</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div class="page-actions"><button id="contact-organize" class="button" type="submit" disabled>整理需求（不发送）</button><button id="contact-reset" class="button-secondary" type="reset">清空填写</button></div>
          <p class="field-help">点击整理只生成本地摘要，不会把表单发送给网站或任何外部服务。</p>
        </fieldset>
      </form>
      <noscript>
        <div class="noscript-note"><h3>未启用 JavaScript，也可以先整理问题。</h3><p>本地校验与摘要工具需要 JavaScript，因此表单保持禁用，避免意外发送填写内容。您仍可按以下方式进行：</p><ol><li>在自己的笔记工具中记录称呼、联系方式、咨询意向和想了解的问题。</li><li>核对并删去不必要的个人信息，妥善保管笔记。</li><li>{hasChannel ? '通过本页已公布的真实联系方式自行沟通；笔记不代表预约。' : '正式预约暂未开放。请等待真实联系渠道公布后，再决定是否分享。'}</li></ol></div>
      </noscript>
    </div>
    <aside class="contact-note" aria-labelledby="channel-heading">
      <p class="eyebrow">Before sharing</p><h3 id="channel-heading">目前可以如何联系？</h3>
      {hasChannel ? <><p>以下渠道来自已确认信息。您需要自行联系；本页不会自动代发摘要，也不确认可预约时间。</p><ul class="channel-list">
        {phone && <li><span class="field-help">电话</span><a class="text-link" href={`tel:${phone.replace(/[ ()-]/g, '')}`}>{phone}</a></li>}
        {email && <li><span class="field-help">邮箱</span><a class="text-link" href={`mailto:${email.split('@').map(encodeURIComponent).join('@')}`}>{email}</a></li>}
      </ul></> : <><p class="channel-status">正式预约暂未开放。</p><p>目前没有可公开的已确认电话或邮箱。您可以先保存问题，待真实联系渠道公布后再沟通。</p></>}
      <div class="contact-note-rule"><h3>整理 → 核对 → 自行选择</h3><p>生成摘要后，您可以复制或下载。信息仍未发送，分享与否由您决定。不要把摘要作为预约凭证。</p></div>
      <a class="text-link" href="/faq/">查看咨询操作问答 <span aria-hidden="true">→</span></a>
    </aside>
  </section>
  <section id="contact-result" class="editorial-section contact-result" hidden tabindex="-1" aria-labelledby="contact-result-heading">
    <p class="eyebrow">Your inquiry / 本地摘要</p><h2 id="contact-result-heading">需求已整理，尚未发送</h2>
    <p class="intro-copy">请核对内容后，自行选择是否复制、下载或分享。这不是预约，也没有收件方收到您的信息。</p>
    <pre id="inquiry-summary" class="inquiry-summary" aria-label="已整理的咨询需求"></pre>
    <div class="page-actions"><button id="copy-summary" class="button" type="button">复制摘要</button><button id="download-summary" class="button-secondary" type="button">下载文本</button></div>
    <p id="copy-status" class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
    <div id="copy-fallback-area" hidden><label for="copy-fallback">可手动复制的咨询摘要</label><textarea id="copy-fallback" rows="9" readonly aria-describedby="copy-status"></textarea></div>
    <p class="small-note">复制会写入系统剪贴板，下载会保存含个人信息的文件。清空本页不会撤回已复制或下载的内容，请妥善保管。</p>
  </section>
</InnerPage>

<script>
  import { buildInquirySummary, getInquiryInterest, normalizeInquiryPhone, validateInquiry, type InquiryField } from '../lib/contact.ts';
  import { documentLocale, translate } from '../lib/i18n.ts';
  const locale = documentLocale(document);
  const tr = (text: string) => translate(text, locale);
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const fields = document.querySelector<HTMLFieldSetElement>('#contact-fields');
  const organize = document.querySelector<HTMLButtonElement>('#contact-organize');
  const name = document.querySelector<HTMLInputElement>('#contact-name');
  const contact = document.querySelector<HTMLInputElement>('#contact-contact');
  const interest = document.querySelector<HTMLSelectElement>('#contact-interest');
  const message = document.querySelector<HTMLTextAreaElement>('#contact-message');
  const privacy = document.querySelector<HTMLInputElement>('#contact-consent');
  const website = document.querySelector<HTMLInputElement>('#contact-website');
  const errorSummary = document.querySelector<HTMLElement>('#contact-error-summary');
  const errorList = document.querySelector<HTMLUListElement>('#contact-error-list');
  const result = document.querySelector<HTMLElement>('#contact-result');
  const output = document.querySelector<HTMLElement>('#inquiry-summary');
  const copy = document.querySelector<HTMLButtonElement>('#copy-summary');
  const download = document.querySelector<HTMLButtonElement>('#download-summary');
  const copyStatus = document.querySelector<HTMLElement>('#copy-status');
  const fallbackArea = document.querySelector<HTMLElement>('#copy-fallback-area');
  const fallback = document.querySelector<HTMLTextAreaElement>('#copy-fallback');
  const count = document.querySelector<HTMLElement>('#message-count');

  if (form && fields && organize && name && contact && interest && message && privacy && website && errorSummary && errorList && result && output && copy && download && copyStatus && fallbackArea && fallback && count) {
    let summary = '';
    let revision = 0;
    const inputs = { name, contact, interest, message, privacy, website };
    const errors: Partial<Record<InquiryField, HTMLElement | null>> = {
      name: document.querySelector('#name-error'),
      contact: document.querySelector('#contact-error'),
      interest: document.querySelector('#interest-error'),
      message: document.querySelector('#message-error'),
      privacy: document.querySelector('#privacy-error'),
    };
    const clearErrors = () => {
      errorSummary.textContent = '';
      errorList.replaceChildren();
      errorList.hidden = true;
      Object.values(inputs).forEach((input) => input.removeAttribute('aria-invalid'));
      Object.values(errors).forEach((error) => { if (error) error.textContent = ''; });
    };
    const invalidate = () => {
      revision++;
      const hadSummary = !!summary;
      summary = '';
      output.textContent = '';
      fallback.value = '';
      fallbackArea.hidden = true;
      result.hidden = true;
      copyStatus.textContent = '';
      if (hadSummary) errorSummary.textContent = tr('您修改了填写，请重新整理；旧摘要已从页面移除。');
    };
    const normalizePhone = () => {
      const caret = contact.selectionStart ?? contact.value.length;
      const position = normalizeInquiryPhone(contact.value.slice(0, caret)).length;
      const value = normalizeInquiryPhone(contact.value);
      if (value !== contact.value) {
        contact.value = value;
        contact.setSelectionRange(position, position);
      }
    };
    contact.addEventListener('input', (event) => {
      if (!(event as InputEvent).isComposing) normalizePhone();
    });
    contact.addEventListener('compositionend', normalizePhone);
    contact.addEventListener('paste', (event) => {
      if (!event.clipboardData) return;
      event.preventDefault();
      const inserted = normalizeInquiryPhone(event.clipboardData.getData('text'));
      const start = contact.selectionStart ?? contact.value.length;
      const end = contact.selectionEnd ?? start;
      // Normalize the full pasted text before applying the native eleven-character limit.
      contact.value = normalizeInquiryPhone(contact.value.slice(0, start) + inserted + contact.value.slice(end));
      const position = Math.min(start + inserted.length, contact.value.length);
      contact.setSelectionRange(position, position);
      contact.dispatchEvent(new Event('input', { bubbles: true }));
    });
    form.addEventListener('submit', (event) => {
      // Attach before enabling fields: no-JS or a failed initialization cannot submit personal data.
      event.preventDefault();
      clearErrors();
      invalidate();
      const validation = validateInquiry({
        name: name.value, contact: contact.value, interest: interest.value, message: message.value,
        privacy: privacy.checked, website: website.value,
      }, locale);
      if (!validation.ok) {
        const entries = Object.entries(validation.errors) as [InquiryField, string][];
        errorSummary.textContent = tr(`尚未整理，请检查以下 ${entries.length} 处填写。信息没有发送。`);
        for (const [field, text] of entries) {
          const item = document.createElement('li');
          if (field === 'website') {
            item.textContent = text;
          } else {
            inputs[field].setAttribute('aria-invalid', 'true');
            const inline = errors[field];
            if (inline) inline.textContent = text;
            const link = document.createElement('a');
            link.href = `#${inputs[field].id}`;
            link.textContent = text;
            link.addEventListener('click', (event) => { event.preventDefault(); inputs[field].focus(); });
            item.append(link);
          }
          errorList.append(item);
        }
        errorList.hidden = false;
        document.querySelector<HTMLElement>('#contact-errors')?.focus();
        return;
      }
      summary = buildInquirySummary(validation.value, locale);
      output.textContent = summary;
      result.hidden = false;
      result.focus();
      document.dispatchEvent(new Event('beiti:inquiry-prepared'));
    });
    form.addEventListener('input', (event) => {
      clearErrors();
      invalidate();
      count.textContent = `${message.value.length} / 1200`;
      if (event.target === privacy && !privacy.checked) {
        errorSummary.textContent = tr('未同意隐私说明时，不会整理摘要。信息没有发送。');
      }
    });
    form.addEventListener('reset', () => {
      clearErrors();
      invalidate();
      count.textContent = '0 / 1200';
      errorSummary.textContent = tr('已清空本页填写与摘要；已复制或下载的内容不会自动删除。');
    });
    copy.addEventListener('click', async () => {
      if (!summary) return;
      const currentRevision = revision;
      copy.disabled = true;
      try {
        if (!window.isSecureContext || !navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(summary);
        if (currentRevision !== revision) return;
        fallbackArea.hidden = true;
        copyStatus.textContent = tr('摘要已复制到剪贴板，尚未发送。请自行核对并选择是否分享。');
      } catch {
        if (currentRevision !== revision) return;
        fallback.value = summary;
        fallbackArea.hidden = false;
        copyStatus.textContent = tr('自动复制未完成，尚未发送。请手动复制下方已选中的文本，或使用“下载文本”。');
        fallback.focus();
        fallback.select();
      } finally {
        copy.disabled = false;
      }
    });
    download.addEventListener('click', () => {
      if (!summary) return;
      let url: string | undefined;
      try {
        url = URL.createObjectURL(new Blob([summary], { type: 'text/plain;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = 'beiti-inquiry.txt';
        document.body.append(link);
        link.click();
        link.remove();
        copyStatus.textContent = tr('已请求浏览器下载文本，尚未发送。请确认本地文件是否保存，并妥善保管。');
      } catch {
        copyStatus.textContent = tr('浏览器未能创建下载，请使用复制摘要或手动复制。信息没有发送。');
        fallback.value = summary;
        fallbackArea.hidden = false;
      } finally {
        if (url) {
          const objectUrl = url;
          window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
        }
      }
    });
    // Exact whitelist lookup, never render query data as HTML or persist it.
    interest.value = getInquiryInterest(new URLSearchParams(window.location.search).get('interest'));
    window.addEventListener('pagehide', () => {
      form.reset();
      invalidate();
      clearErrors();
    });
    fields.disabled = false;
    organize.disabled = false;
  }
</script>

<style>
  [hidden] { display: none !important; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, .85fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .form-intro { line-height: 1.8; max-width: 42rem; margin-bottom: 1.5rem; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .field-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .form-field { margin-bottom: 1.8rem; }
  label { display: block; line-height: 1.8; margin-bottom: .7rem; }
  .field-required { margin-left: .5rem; font-size: calc(.75rem + 2px); color: var(--muted, #686258); }
  input:not([type=checkbox]), select, textarea { width: 100%; min-height: 3.3rem; padding: .8rem 1rem; color: inherit; font: inherit; line-height: 1.7; border: 1px solid var(--line, #b9ae9a); background: transparent; border-radius: 0; }
  textarea { resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--ink, #232620); outline-offset: 3px; }
  [aria-invalid=true] { border-color: #8d352c !important; }
  .field-help { color: var(--muted, #686258); font-size: calc(.8rem + 2px); line-height: 1.8; margin: .5rem 0 0; }
  .field-error { color: #8d352c; font-size: calc(.9rem + 2px); line-height: 1.7; margin: .5rem 0 0; }
  .field-error:empty { display: none; }
  .message-help-row { display: flex; gap: 1rem; justify-content: space-between; align-items: baseline; }
  #message-count { flex-shrink: 0; }
  .consent-field { display: flex; align-items: flex-start; gap: .9rem; }
  .consent-field input { margin: .4rem 0 0; flex-shrink: 0; width: 1.2rem; height: 1.2rem; accent-color: var(--ink, #232620); }
  .consent-field label { font-size: calc(.9rem + 2px); min-height: 44px; cursor: pointer; }
  .error-summary { color: #8d352c; line-height: 1.8; }
  .error-summary:not(:has(p:empty)) { margin-block: 1.5rem; padding-block: 1rem; border-block: 1px solid #8d352c; }
  .error-summary p:empty { margin: 0; }
  .error-summary a { color: inherit; text-decoration: underline; }
  .error-summary:focus-visible, .contact-result:focus-visible { outline: 2px solid var(--ink, #232620); outline-offset: 8px; }
  .contact-note { padding-left: clamp(1.5rem, 3vw, 3rem); border-left: 1px solid var(--line, #d9d1c4); }
  .contact-note h3 { margin-top: .8rem; }
  .contact-note p { line-height: 1.9; }
  .channel-status { font-size: 1.2rem; }
  .contact-note-rule { padding-block: 1.5rem; margin-top: 2rem; border-top: 1px solid var(--line, #d9d1c4); }
  .channel-list { list-style: none; padding: 0; }
  .channel-list li { display: grid; gap: .5rem; margin-block: 1.5rem; overflow-wrap: anywhere; }
  .inquiry-summary { border-block: 1px solid var(--line, #d9d1c4); padding-block: 2rem; margin-block: 2rem; font: inherit; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; }
  .copy-status { line-height: 1.8; min-height: 1.8em; }
  #copy-fallback-area { margin-block: 1.5rem; }
  .noscript-note { padding-top: 2rem; line-height: 1.9; }
  button { min-height: 44px; }
  @media (max-width: 800px) { .contact-grid { grid-template-columns: minmax(0, 1fr); } .contact-note { padding: 2rem 0 0; border-left: 0; border-top: 1px solid var(--line, #d9d1c4); } }
  @media (max-width: 540px) { .field-pair { grid-template-columns: minmax(0, 1fr); gap: 0; } .message-help-row { flex-wrap: wrap; gap: 0; } }
</style>
