---
import SiteLayout from '../../layouts/SiteLayout.astro';
import VisualIntro from '../../components/VisualIntro.astro';
import VisualPhoto from '../../components/VisualPhoto.astro';
import VisualGallery from '../../components/VisualGallery.astro';
import { copy, imageById, imagesFor, trainingNotice, visualSeries, type VisualSeries } from '../../lib/visual-catalog.ts';
import { localeFromPath, localizedPath } from '../../lib/i18n.ts';
export function getStaticPaths() {
  return visualSeries.filter(item => item.section === 'training').map(series => ({ params: { slug: series.path.split('/')[2] }, props: { series } }));
}
interface Props { series: VisualSeries }
const { series } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const href = (path: string) => localizedPath(path, locale);
const title = copy(series.title, locale);
---
<SiteLayout title={title} description={copy(series.description, locale)} breadcrumbs={[{ label: en ? 'Explore beauty' : '探索美业', href: '/services/' }, { label: en ? 'Beauty training' : '美业培训', href: '/training/' }, { label: title }]}>
  <VisualIntro title={title} subtitle={copy(series.subtitle, locale)} description={copy(series.description, locale)} eyebrow="BEITI / LEARNING DIRECTIONS" image={series.cover} />
  <div class="container visual-page-body">
    <p class="visual-boundary">{copy(trainingNotice, locale)}</p>
    <section class="visual-topics" aria-labelledby="learning-topics-title">
      <div class="visual-section-heading"><p class="eyebrow">{en ? 'WHAT TO EXPLORE' : '从细节开始'}</p><h2 id="learning-topics-title">{en ? 'Three directions to consider' : '值得了解的三个方向'}</h2></div>
      {series.topics.map(topic => <article class="visual-training-row">
        <figure class="visual-training-photo"><VisualPhoto image={imageById(topic.image)} /></figure>
        <div class="visual-training-copy"><h3>{copy(topic.title, locale)}</h3><p>{copy(topic.description, locale)}</p></div>
      </article>)}
    </section>
    <section class="visual-considerations" aria-labelledby="before-learning-title">
      <div><p class="eyebrow">{en ? 'BEFORE YOU BEGIN' : '开始之前'}</p><h2 id="before-learning-title">{en ? 'Make an informed learning choice.' : '让学习的选择，更清楚。'}</h2></div>
      <div>
        <h3>{en ? 'Who may find this useful' : '适合谁了解'}</h3><p>{en ? 'Adults exploring this field, comparing learning directions or gathering questions before choosing a course.' : '希望了解这个领域、比较学习方向，或在选择课程前整理问题的成年人。'}</p>
        <h3>{en ? 'What this page cannot provide' : '不适用与边界'}</h3><p>{en ? 'This page cannot replace supervised practical instruction and does not promise certification, employment or earnings.' : '此页面不能替代专业指导下的实操，不承诺证书、就业或收益。'}</p>
        <h3>{en ? 'What needs confirmation' : '需要进一步确认'}</h3><p>{en ? 'Ask about prior experience, instruction, materials, available dates, costs and the learning location through a confirmed contact channel.' : '请通过已确认的联系渠道，进一步了解基础要求、教学安排、材料工具、课期、费用与地点。'}</p>
        <a class="text-link" href={href(`/contact/?interest=learning`)}>{en ? 'Prepare your learning questions' : '整理学习咨询需求'} ↗</a>
      </div>
    </section>
    <section aria-labelledby="learning-visuals-title"><div class="visual-section-heading"><p class="eyebrow">VISUAL NOTES</p><h2 id="learning-visuals-title">{en ? 'Learning, in pictures' : '学习方向影像'}</h2><p>{en ? 'Ten concept photographs to explore the atmosphere and details.' : '十张概念摄影，观察氛围与细节。'}</p></div>
      <VisualGallery images={imagesFor(series)} />
    </section>
    <div class="visual-bottom-link"><a class="text-link" href={href('/training/')}>{en ? 'All learning directions' : '全部学习方向'} ↗</a><a class="text-link" href={href('/gallery/')}>{en ? 'Visual collection' : '美学图鉴'} ↗</a></div>
  </div>
</SiteLayout>
