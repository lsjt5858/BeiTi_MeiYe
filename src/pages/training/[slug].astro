---
import SiteLayout from '../../layouts/SiteLayout.astro';
import VisualIntro from '../../components/VisualIntro.astro';
import VisualGallery from '../../components/VisualGallery.astro';
import CourseOutline from '../../components/CourseOutline.astro';
import RetrainingNote from '../../components/RetrainingNote.astro';
import { copy, imagesFor, visualSeries, type VisualSeries } from '../../lib/visual-catalog.ts';
import { localeFromPath, localizedPath, translate } from '../../lib/i18n.ts';
import { getContactPhone, getLocations } from '../../lib/content.ts';
import { getCourseOutline, type TrainingDirection } from '../../lib/training.ts';
export function getStaticPaths() {
  return visualSeries.filter(item => item.section === 'training').map(series => ({ params: { slug: series.path.split('/')[2] }, props: { series } }));
}
interface Props { series: VisualSeries }
const { series } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const href = (path: string) => localizedPath(path, locale);
const title = copy(series.title, locale);
const direction = series.path.split('/')[2] as TrainingDirection;
const outline = getCourseOutline(direction);
const description = outline ? translate(outline.intro, locale) : copy(series.description, locale);
const campus = getLocations()[0];
const campusAddress = en ? 'Building 16, Jintong Digital Economy Science and Innovation Park, 29 Xingye Street, Gongshu District, Hangzhou' : campus?.address;
const campusTransport = en ? 'Metro Line 4, Huazhong South Road Station, Exit E' : campus?.transport;
const { display: phone, tel } = getContactPhone();
---
<SiteLayout title={title} description={description} breadcrumbs={[{ label: en ? 'Explore beauty' : '探索美业', href: '/services/' }, { label: en ? 'Beauty training' : '美业培训', href: '/training/' }, { label: title }]}>
  <VisualIntro title={title} subtitle={copy(series.subtitle, locale)} description={description} eyebrow="BEITI / COURSES" image={series.cover} />
  <div class="container visual-page-body">
    <CourseOutline direction={direction} />
    <RetrainingNote />
    {campus && <section class="visual-campus" aria-labelledby="campus-title">
      <div><p class="eyebrow">CAMPUS</p><h2 id="campus-title">{en ? 'Where this class takes place' : '上课地点'}</h2></div>
      <div>
        <p>{campusAddress}</p>
        <p>{campusTransport}</p>
        {phone && <p>{en ? 'Consultation phone: ' : '咨询电话：'}{tel ? <a class="text-link" href={`tel:${tel}`}>{phone}</a> : <span>{phone}</span>}</p>}
        <a class="text-link" href={href('/locations/')}>{en ? 'Campus address and visiting notes' : '校区地址与到访说明'} ↗</a>
      </div>
    </section>}
    <section aria-labelledby="learning-visuals-title"><div class="visual-section-heading"><p class="eyebrow">VISUAL NOTES</p><h2 id="learning-visuals-title">{en ? 'Learning, in pictures' : '学习方向影像'}</h2><p>{en ? 'Ten images to explore the atmosphere and details.' : '十张影像，观察氛围与细节。'}</p></div>
      <VisualGallery images={imagesFor(series)} />
    </section>
    <div class="visual-bottom-link"><a class="text-link" href={href('/training/')}>{en ? 'All learning directions' : '全部学习方向'} ↗</a><a class="text-link" href={href('/gallery/')}>{en ? 'Visual collection' : '美学图鉴'} ↗</a></div>
  </div>
</SiteLayout>
