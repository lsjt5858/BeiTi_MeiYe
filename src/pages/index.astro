---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeVisuals from "../components/HomeVisuals.astro";
import { brandMedia } from "../components/brand-media.mjs";
import { site, getArticles, getLatestUpdate } from "../lib/content";
import { localeFromPath, translate } from "../lib/i18n.ts";
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const tr = (text: string) => translate(text, locale);
const publishedArticles = getArticles();
const articles = [
  {
    slug: 'solid-color-even-coating',
    topic: en ? 'NAILS / EVEN COATING' : '美甲 / 单色上色',
    summary: en ? 'Separate uneven colour coverage from an uneven nail surface before deciding what to practise next.' : '涂不匀，先分清颜色覆盖和甲面起伏，再决定下一步怎么练。',
    alt: en ? 'A nude nail tip showing colour coverage and surface reflections; illustrative brand imagery.' : '裸色甲片的颜色覆盖与表面反光，品牌视觉示意',
  },
  {
    slug: 'nail-structure-light-reflection',
    topic: en ? 'NAILS / STRUCTURE & LIGHT' : '美甲 / 建构观察',
    summary: en ? 'One reflection line cannot reveal the whole structure. Change the light and viewing angle to check what is causing the difference.' : '一条光圈看不出全部结构。换灯位，也换角度，分清反光和甲面的问题。',
    alt: en ? 'A curved nail tip viewed under directional light; illustrative brand imagery.' : '光线下建构甲片的弧度与反光，品牌视觉示意',
  },
  {
    slug: 'lash-curl-jbcd',
    topic: en ? 'LASHES / UNDERSTANDING CURL' : '美睫 / 翘度判断',
    summary: en ? 'Look beyond J, B, C and D. Examine the root, shaft and tip, then assess the result with the eyes open.' : '不只看 J、B、C、D。把毛根、毛干和毛尖分开看，再回到睁眼后的观感。',
    alt: en ? 'Lash samples with different curves arranged on a ceramic tray; illustrative brand imagery.' : '陶瓷托盘上不同弧线的睫毛样品，品牌视觉示意',
  },
].flatMap((selection) => {
  const article = publishedArticles.find((item) => item.slug === selection.slug);
  return article ? [{ ...article, ...selection }] : [];
});
const imageSrc = (image: (typeof brandMedia)[number]) => image.frozen ? image.src : image.generationUrl;
---
<SiteLayout title={`${site.brand} | 让美，成为日常。`} home>
  <section class="hero" data-carousel aria-roledescription="轮播" aria-label="品牌美学影像">
    <div class="hero-slides">
      {brandMedia.map((image, index) => <figure class:list={["hero-slide", { "is-active": index === 0 }]} data-slide data-label={image.label} aria-hidden={index !== 0 ? "true" : "false"} role="group" aria-roledescription="幻灯片" aria-label={`${index + 1} / ${brandMedia.length}`}>
        <img src={imageSrc(image)} alt={image.alt} width="2560" height="1440" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} decoding="async" data-media-id={image.id} />
      </figure>)}
    </div>
    <div class="hero-content">
      <p class="eyebrow">BEITI BEAUTY · THE ART OF EVERYDAY BEAUTY</p>
      <h1>{site.brand}</h1>
      <p class="hero-tagline">让美，成为日常。</p>
      <div class="hero-actions">
        <a class="button" href="/contact/" data-analytics-category="general">找我们聊聊 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#explore">探索你的美 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div data-carousel-controls hidden>
      <div class="carousel-arrows">
        <button class="carousel-arrow" type="button" data-prev aria-label="上一张品牌影像"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 5-7 7 7 7" stroke="currentColor" stroke-width="1.2"/></svg></button>
        <button class="carousel-arrow" type="button" data-next aria-label="下一张品牌影像"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 5 7 7-7 7" stroke="currentColor" stroke-width="1.2"/></svg></button>
      </div>
    </div>
    <div class="hero-bottom">
      <p class="hero-caption"><span data-slide-caption>{brandMedia[0].label}</span><small>生成影像仅作品牌美学表达，非真实服务成果</small></p>
      <div class="carousel-pagination" data-carousel-controls hidden>
        <p class="carousel-count" aria-hidden="true"><span data-slide-count>01</span><span> / 03</span></p>
        <div class="carousel-dots" role="group" aria-label="选择品牌影像">
          {brandMedia.map((image, index) => <button class="carousel-dot" type="button" data-dot aria-label={`查看第 ${index + 1} 张：${image.label}`} aria-current={index === 0 ? "true" : "false"}></button>)}
        </div>
        <button class="carousel-pause" type="button" data-pause aria-label="暂停自动播放" aria-pressed="false">
          <svg class="pause-icon" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 2v10M10 2v10" stroke="currentColor" stroke-width="1.4"/></svg>
          <svg class="play-icon" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m4 2 7 5-7 5Z" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
      </div>
      <a class="hero-scroll" href="#explore">SCROLL TO EXPLORE</a>
    </div>
    <span class="visually-hidden" data-slide-status role="status" aria-live="polite" aria-atomic="true"></span>
  </section>

  <HomeVisuals />

  <section class="philosophy-section">
    <div class="container split philosophy-layout">
      <figure class="editorial-photo philosophy-photo" data-reveal>
        <img src="/images/technique/natural-lashes-space-color.jpg" alt="自然感睫毛眼部特写，品牌视觉示意，不是学员或客户成果" width="1600" height="900" loading="lazy" decoding="async" />
        <figcaption>自然感，留白也重要 · 品牌视觉示意</figcaption>
      </figure>
      <div class="philosophy-copy" data-reveal>
        <p class="eyebrow">01 / OUR PHILOSOPHY</p>
        <h2>美，不必被定义。<br />只需忠于自己。</h2>
        <p>我们向往的美，是光落在肌肤上的自然，是举手之间的细节，也是你自在表达自己的样子。</p>
        <p>贝缇美业，让关于美的每一个想法，都从倾听自己开始。不急于改变，先了解你真正想要的。</p>
        <a class="text-link" href="/about/">走近贝缇 <span aria-hidden="true">↗</span></a>
        <span class="philosophy-mark" lang="en" aria-hidden="true">Beautifully, yourself.</span>
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">02 / START A CONVERSATION</p><h2>从了解，<br />到更清晰的选择。</h2></div>
        <p>不必一次想清楚所有细节。<br />用三个简单步骤，把想法整理好。</p>
      </div>
      <ol class="process-steps">
        <li data-reveal><span class="process-number" aria-hidden="true">01</span><h3>说说你的想法</h3><p>选择感兴趣的方向，写下需求、偏好和希望进一步了解的问题。</p></li>
        <li data-reveal><span class="process-number" aria-hidden="true">02</span><h3>了解信息与边界</h3><p>查看已确认的服务、价格与地点。没有发布的内容，不作预设或承诺。</p></li>
        <li data-reveal><span class="process-number" aria-hidden="true">03</span><h3>整理咨询摘要</h3><p>在你的设备上生成摘要，复制或下载后自行保留。你的需求不会自动发送。</p></li>
      </ol>
      <div class="process-footnote">
        <p>把想了解的问题整理成摘要，再通过已公布的联系方式沟通。</p>
        <a class="text-link" href="/contact/" data-analytics-category="general">开始整理需求 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <p class="visually-hidden"><time datetime={getLatestUpdate()}>{getLatestUpdate().slice(0, 10)}</time></p>
  {articles.length > 0 && <section id="craft-notes" class="section home-articles" aria-labelledby="craft-notes-title">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">03 / CRAFT NOTES</p>
          <h2 id="craft-notes-title">{en ? <>Understand the detail.<br />Then practise.</> : <>看懂细节，<br />再练手法。</>}</h2>
        </div>
        <div class="home-articles-intro">
          <p>{en ? 'From even colour to nail structure and lash curls, see how each decision is broken down.' : '从单色、建构到美睫翘度，看看判断是怎么一步步拆开的。'}</p>
          <a class="text-link" href="/articles/?category=craft">{en ? 'More craft notes' : '更多技法笔记'} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <ul class="home-article-list">
        {articles.map((article) => {
          const updatedAt = article.updatedAt || article.updated_at;
          return <li data-reveal>
            <a class="home-article-link" href={`/articles/${article.slug}/`} aria-labelledby={`home-article-${article.slug}`}>
              <figure class="home-article-photo">
                <img src={`/images/technique/${article.slug}.jpg`} alt={article.alt} width="1600" height="900" loading="lazy" decoding="async" />
                <figcaption>{en ? 'Illustrative brand imagery, not student work.' : '品牌视觉示意，非学员作品'}</figcaption>
              </figure>
              <div class="home-article-copy">
                <p class="home-article-topic">{article.topic}</p>
                <h3 id={`home-article-${article.slug}`}>{tr(article.title)}</h3>
                <p class="home-article-summary">{article.summary}</p>
                <span class="home-article-read">{en ? 'Read note' : '阅读笔记'} <span aria-hidden="true">↗</span></span>
                <time class="visually-hidden" datetime={updatedAt}>{updatedAt.slice(0, 10)}</time>
              </div>
            </a>
          </li>;
        })}
      </ul>
    </div>
  </section>}

  <section class="closing-section">
    <img class="closing-image" src={imageSrc(brandMedia[2])} alt={brandMedia[2].alt} width="2560" height="1440" loading="lazy" decoding="async" data-media-id="ritual" />
    <div class="container" data-reveal>
      <p class="eyebrow">YOUR BEAUTY, YOUR WAY</p>
      <h2>下一段美好，<br />从你的想法开始。</h2>
      <p>把关于美的期待，慢慢说给我们听。</p>
      <a class="button" href="/contact/" data-analytics-category="general">找我们聊聊 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
