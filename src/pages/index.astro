---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeVisuals from "../components/HomeVisuals.astro";
import { brandMedia } from "../components/brand-media.mjs";
import { site, getFact, getServices, getFaqs, getArticles } from "../lib/content";
const services = getServices();
const articles = getArticles().slice(0, 3);
const faqs = getFaqs().slice(0, 4);
const intents: { name: string; english: string; interest: string; note?: string }[] = [
  { name: "美甲培训", english: "NAIL TRAINING", interest: "nails" },
  { name: "美睫培训", english: "LASH TRAINING", interest: "lashes" },
  { name: "店务运营管理", english: "SALON MANAGEMENT", interest: "management" },
  { name: "视频美学", english: "VIDEO AESTHETICS", interest: "video", note: getFact<string>('course.video-aesthetics.gift') },
];
const imageSrc = (image: (typeof brandMedia)[number]) => image.frozen ? image.src : image.generationUrl;
---
<SiteLayout title={`${site.brand} | 让美，成为日常。`} home>
  <section class="hero" data-carousel aria-roledescription="轮播" aria-label="品牌美学影像">
    <div class="hero-slides">
      {brandMedia.map((image, index) => <figure class:list={["hero-slide", { "is-active": index === 0 }]} data-slide data-label={image.label} aria-hidden={index !== 0 ? "true" : "false"} role="group" aria-roledescription="幻灯片" aria-label={`${index + 1} / ${brandMedia.length}`}>
        <img src={imageSrc(image)} alt={image.alt} width="2560" height="1440" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} decoding="async" data-media-id={image.id} />
      </figure>)}
    </div>
    <div class="hero-content">
      <p class="eyebrow">BEITI BEAUTY · THE ART OF EVERYDAY BEAUTY</p>
      <h1>{site.brand}</h1>
      <p class="hero-tagline">让美，成为日常。</p>
      <div class="hero-actions">
        <a class="button" href="/contact/" data-analytics-category="general">聊聊你的需求 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#explore">探索你的美 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div data-carousel-controls hidden>
      <div class="carousel-arrows">
        <button class="carousel-arrow" type="button" data-prev aria-label="上一张品牌影像"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 5-7 7 7 7" stroke="currentColor" stroke-width="1.2"/></svg></button>
        <button class="carousel-arrow" type="button" data-next aria-label="下一张品牌影像"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 5 7 7-7 7" stroke="currentColor" stroke-width="1.2"/></svg></button>
      </div>
    </div>
    <div class="hero-bottom">
      <p class="hero-caption"><span data-slide-caption>{brandMedia[0].label}</span><small>生成影像仅作品牌美学表达，非真实服务成果</small></p>
      <div class="carousel-pagination" data-carousel-controls hidden>
        <p class="carousel-count" aria-hidden="true"><span data-slide-count>01</span><span> / 03</span></p>
        <div class="carousel-dots" role="group" aria-label="选择品牌影像">
          {brandMedia.map((image, index) => <button class="carousel-dot" type="button" data-dot aria-label={`查看第 ${index + 1} 张：${image.label}`} aria-current={index === 0 ? "true" : "false"}></button>)}
        </div>
        <button class="carousel-pause" type="button" data-pause aria-label="暂停自动播放" aria-pressed="false">
          <svg class="pause-icon" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 2v10M10 2v10" stroke="currentColor" stroke-width="1.4"/></svg>
          <svg class="play-icon" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m4 2 7 5-7 5Z" stroke="currentColor" stroke-width="1.2"/></svg>
        </button>
      </div>
      <a class="hero-scroll" href="#explore">SCROLL TO EXPLORE</a>
    </div>
    <span class="visually-hidden" data-slide-status role="status" aria-live="polite" aria-atomic="true"></span>
  </section>

  <section id="explore" class="section intent-section">
    <div class="container">
      <div class="intent-layout" data-reveal>
        <div>
          <p class="eyebrow">01 / EXPLORE YOUR BEAUTY</p>
          <h2>把热爱，<br />练成专业。</h2>
          <p class="intent-note">从美甲培训、美睫培训到店务运营管理，找到你想了解的方向。<br />课程内容与安排待补充，可先整理咨询问题。</p>
        </div>
        <ol class="intent-list">
          {intents.map((intent, index) => <li>
            <a class="intent-link" href={`/contact/?interest=${intent.interest}`} data-analytics-category={intent.interest}>
              <span class="intent-number" aria-hidden="true">0{index + 1}</span>
              <span class="intent-title">{intent.name}<small lang="en">{intent.english}</small>{intent.note && <span class="intent-description">{intent.note}</span>}</span>
              <span class="intent-arrow" aria-hidden="true">↗</span>
            </a>
          </li>)}
        </ol>
      </div>
      {services.length > 0 && <div class="confirmed-services" data-reveal>
        <p class="eyebrow">CONFIRMED INFORMATION</p>
        <h3>已确认的服务信息</h3>
        <ul>{services.map((service) => <li><a href={`/services/${service.slug}/`}>{service.name} <span aria-hidden="true">↗</span></a>{service.summary && <p>{service.summary}</p>}{service.updatedAt && <p class="meta">内容更新：<time datetime={service.updatedAt}>{service.updatedAt.slice(0, 10)}</time></p>}</li>)}</ul>
      </div>}
    </div>
  </section>

  <HomeVisuals />

  <section class="philosophy-section">
    <div class="container split philosophy-layout">
      <figure class="editorial-photo philosophy-photo" data-reveal>
        <img src={imageSrc(brandMedia[1])} alt={brandMedia[1].alt} width="2560" height="1440" loading="lazy" decoding="async" data-media-id="detail" />
        <figcaption>THE BEAUTY OF DETAILS · 品牌美学视觉</figcaption>
      </figure>
      <div class="philosophy-copy" data-reveal>
        <p class="eyebrow">02 / OUR PHILOSOPHY</p>
        <h2>美，不必被定义。<br />只需忠于自己。</h2>
        <p>我们向往的美，是光落在肌肤上的自然，是举手之间的细节，也是你自在表达自己的样子。</p>
        <p>贝缇美业，让关于美的每一个想法，都从倾听自己开始。不急于改变，先了解你真正想要的。</p>
        <a class="text-link" href="/about/">走近贝缇 <span aria-hidden="true">↗</span></a>
        <span class="philosophy-mark" lang="en" aria-hidden="true">Beautifully, yourself.</span>
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">03 / START A CONVERSATION</p><h2>从了解，<br />到更清晰的选择。</h2></div>
        <p>不必一次想清楚所有细节。<br />用三个简单步骤，把想法整理好。</p>
      </div>
      <ol class="process-steps">
        <li data-reveal><span class="process-number" aria-hidden="true">01</span><h3>说说你的想法</h3><p>选择感兴趣的方向，写下需求、偏好和希望进一步了解的问题。</p></li>
        <li data-reveal><span class="process-number" aria-hidden="true">02</span><h3>了解信息与边界</h3><p>查看已确认的服务、价格与地点。没有发布的内容，不作预设或承诺。</p></li>
        <li data-reveal><span class="process-number" aria-hidden="true">03</span><h3>整理咨询摘要</h3><p>在你的设备上生成摘要，复制或下载后自行保留。你的需求不会自动发送。</p></li>
      </ol>
      <div class="process-footnote">
        <p>当前支持本地需求整理；未公布正式渠道前，暂不开放正式预约。</p>
        <a class="text-link" href="/contact/" data-analytics-category="general">开始整理需求 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="home-faq">
        <div class="home-faq-heading" data-reveal>
          <p class="eyebrow">04 / GOOD TO KNOW</p>
          <h2>在开始之前，<br />你可能想知道。</h2>
          <a class="text-link" href="/faq/">查看常见问题 <span aria-hidden="true">↗</span></a>
        </div>
        {faqs.length > 0 ? <div class="home-faq-list" data-reveal>
          {faqs.map((faq, index) => <details id={`home-faq-${faq.id}`}>
            <summary><span class="home-faq-number" aria-hidden="true">0{index + 1}</span>{faq.question}</summary>
            <div class="home-faq-answer"><p>{faq.answer}</p>{"updatedAt" in faq && faq.updatedAt && <time class="meta" datetime={faq.updatedAt}>更新：{faq.updatedAt.slice(0, 10)}</time>}</div>
          </details>)}
        </div> : <div data-reveal>
          <p>把想了解的问题整理下来，从一个想法开始。</p>
          <a class="text-link" href="/contact/">整理你的问题 <span aria-hidden="true">↗</span></a>
        </div>}
      </div>
      {articles.length > 0 && <div class="home-articles" data-reveal>
        <p class="eyebrow">BEAUTY JOURNAL</p><h2>美学手记</h2>
        <ul>{articles.map((article) => {
          const updatedAt = article.updatedAt || article.updated_at;
          return <li><h3><a href={`/articles/${article.slug}/`}>{article.title} <span aria-hidden="true">↗</span></a></h3><p>{article.description}</p><time class="meta" datetime={updatedAt}>更新：{updatedAt.slice(0, 10)}</time></li>;
        })}</ul>
        <a class="text-link" href="/articles/">阅读更多 <span aria-hidden="true">↗</span></a>
      </div>}
    </div>
  </section>

  <section class="closing-section">
    <img class="closing-image" src={imageSrc(brandMedia[2])} alt={brandMedia[2].alt} width="2560" height="1440" loading="lazy" decoding="async" data-media-id="ritual" />
    <div class="container" data-reveal>
      <p class="eyebrow">YOUR BEAUTY, YOUR WAY</p>
      <h2>下一段美好，<br />从你的想法开始。</h2>
      <p>把关于美的期待，慢慢说给我们听。</p>
      <a class="button" href="/contact/" data-analytics-category="general">聊聊你的需求 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
