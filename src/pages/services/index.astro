---
import InnerPage from '../_shared/InnerPage.astro';
import { getServices } from '../../lib/content.ts';
import { safeSlug, formatValue } from '../_shared/values.ts';
import VisualPhoto from '../../components/VisualPhoto.astro';
import { imageById } from '../../lib/visual-catalog.ts';
import { localeFromPath, localizedPath } from '../../lib/i18n.ts';
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const href = (path: string) => localizedPath(path, locale);
const services = getServices();
const description = services.length
  ? '这里展示已确认的服务信息。请先查看适用条件、项目边界与计费说明，再决定需要咨询什么。'
  : '目前还没有可公开的已确认服务清单。您可以先整理自己的需求；咨询意向不代表某项服务已经开设。';
---
<InnerPage title="先了解，再选择。" eyebrow="Services / 服务信息" description={description} breadcrumbs={[{ label: '服务信息' }]}>
  <section class="editorial-section" aria-labelledby="explore-visual-heading">
    <h2 id="explore-visual-heading">{en ? 'Learning and visual inspiration' : '探索技艺与美学灵感'}</h2>
    <div class="explore-hubs">
      <article class="explore-hub">
        <a href={href('/training/')} aria-label={en ? 'Beauty training' : '美业培训'}><VisualPhoto image={imageById('01-08')} /></a>
        <h3><a href={href('/training/')}>{en ? 'Beauty training' : '美业培训'}</a></h3>
        <p>{en ? 'Nail training, lash training and salon management: explore learning directions before choosing a course.' : '从美甲、美睫到店务运营，先了解学习方向，再整理自己的课程咨询问题。'}</p>
        <a class="text-link" href={href('/training/')}>{en ? 'Explore learning directions' : '了解学习方向'} ↗</a>
      </article>
      <article class="explore-hub">
        <a href={href('/gallery/')} aria-label={en ? 'Visual collection' : '美学图鉴'}><VisualPhoto image={imageById('05-02')} /></a>
        <h3><a href={href('/gallery/')}>{en ? 'Visual collection' : '美学图鉴'}</a></h3>
        <p>{en ? 'Explore nail details, lash details and Japanese nail art through colour, texture and light.' : '从裸色、柔睫到日式晕染，在配色、材质与光影中寻找自己的偏爱。'}</p>
        <a class="text-link" href={href('/gallery/')}>{en ? 'Discover visual inspiration' : '浏览美学灵感'} ↗</a>
      </article>
    </div>
    <p class="visual-notice">{en ? 'Learning directions do not indicate confirmed services or available classes.' : '学习方向不代表已确认服务或已经开班。'}</p>
  </section>
  <section class="editorial-section" aria-labelledby="services-heading">
    {services.length ? <>
      <h2 id="services-heading">已确认服务</h2>
      <ol class="editorial-list">
        {services.map((service, index) => <li class="editorial-row">
          <div><span class="row-number">{String(index + 1).padStart(2, '0')}</span><h3><a class="text-link" href={`/services/${safeSlug(service.slug)}/`}>{service.name}</a></h3></div>
          <div><p>{service.summary || '请查看这项服务已确认的适用范围与具体说明。'}</p>
            {formatValue(service.duration) && <p class="meta">时长：{formatValue(service.duration)}</p>}
            <a class="text-link" href={`/services/${safeSlug(service.slug)}/`}>了解条件与计费 <span aria-hidden="true">→</span></a>
          </div>
        </li>)}
      </ol>
    </> : <div class="empty-editorial empty-state">
      <p class="eyebrow">Information first</p>
      <h2 id="services-heading">把期待说清楚，<br />让选择有依据。</h2>
      <p>服务内容、时长与价格需要逐项确认后才会出现在这里。现在可以先记录想改善或了解的方向、预计时间，以及最关心的问题。</p>
      <a class="button" href="/contact/">整理我的咨询需求</a>
    </div>}
  </section>
  <section class="editorial-section" aria-labelledby="before-heading">
    <h2 id="before-heading">咨询前，需要了解的 3 件事</h2>
    <ol class="editorial-list">
      <li class="editorial-row"><div><span class="row-number">01</span><h3>是否适合自己？</h3></div><p>先询问适用与不适用条件，以及需要提前说明的个人情况。涉及敏感信息时，先确认接收渠道和必要性，不在此页面填写健康记录。</p></li>
      <li class="editorial-row"><div><span class="row-number">02</span><h3>费用具体包含什么？</h3></div><p>确认计费单位、包含与不包含项目，以及是否存在需要另行说明的费用。<a class="text-link" href="/pricing/">查看价格信息说明</a>。</p></li>
      <li class="editorial-row"><div><span class="row-number">03</span><h3>时间与地点如何确认？</h3></div><p>不要把咨询摘要当作预约。请在正式联系渠道公布后，另行确认可用时间、地点与具体安排。</p></li>
    </ol>
  </section>
</InnerPage>
