---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Callout from '../components/Callout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import CoverBlock from '../components/CoverBlock.astro';
import ComparisonBlock from '../components/ComparisonBlock.astro';
import QaBlock from '../components/QaBlock.astro';
import PrintButton from '../components/PrintButton.astro';
---
<SiteLayout title="编辑样式参考" description="贝缇官网内部编辑样式参考：章节标题、提示块、状态徽标、封面、双栏对比、问答、表格与打印版式。" breadcrumbs={[{ label: '编辑样式参考' }]}>
  <div class="container kit-page">
    <CoverBlock
      eyebrow="BEITI / EDITORIAL KIT"
      title="把信息，排得清楚一点。"
      conclusion="一套给贝缇官网用的编辑模块：结论先行、边界清楚、表格可读，文章能带着目录读，也能打印带走。"
      meta={['更新于 2026-11-19', '7 个模块', '1 个文章样例']}
    >
      <div class="kit-cover-actions">
        <StatusBadge status="local" label="内部预览" />
        <a class="text-link" href="/articles/preview-article-typography/">打开文章样例 ↗</a>
      </div>
    </CoverBlock>

    <nav class="kit-toc" aria-label="本页目录">
      <a href="#kit-foundation-title"><span>01</span>章节标题</a>
      <a href="#kit-callout-title"><span>02</span>提示块</a>
      <a href="#kit-compare-title"><span>03</span>封面与双栏</a>
      <a href="#kit-typography-title"><span>04</span>文章排版</a>
      <a href="#kit-qa-title"><span>05</span>QA 与打印</a>
      <a href="#kit-live-title"><span>06</span>线上参考</a>
      <a href="#kit-status-title"><span>07</span>模块清单</a>
      <a href="#kit-inventory-title"><span>08</span>素材库</a>
    </nav>

    <section class="kit-section" aria-labelledby="kit-foundation-title">
      <SectionHeader number="01" eyebrow="FOUNDATION" title="章节标题，先给编号" headingId="kit-foundation-title" description="编号、英文 eyebrow、中文标题。长页面靠它建立节奏，读者也能快速知道自己在哪一节。">
        <StatusBadge status="confirmed" label="已落地" />
      </SectionHeader>

      <div class="kit-card">
        <SectionHeader number="02" eyebrow="DEMO" title="这是一个章节标题" description="描述放在右侧，标题保持单行或两行，不堆信息。" />
        <p class="kit-muted">实际页面中，编号按章节顺序递增；文章页则不使用编号，改用 h2/h3 目录。</p>
      </div>

      <div class="kit-grid kit-grid--spaced">
        <div class="kit-card">
          <p class="eyebrow">STATUS BADGES</p>
          <h3>五种状态，一眼分清</h3>
          <div class="kit-badges">
            <StatusBadge status="confirmed" label="已确认" />
            <StatusBadge status="pending" label="待确认" />
            <StatusBadge status="conditional" label="条件确认" />
            <StatusBadge status="soon" label="待开通" />
            <StatusBadge status="local" label="本地整理" />
          </div>
          <p class="kit-muted">状态只用来说明信息成熟度，不做装饰；未确认的内容不写成已确认。</p>
        </div>
        <div class="kit-card">
          <p class="eyebrow">CALLOUT TONES</p>
          <h3>三种提示，各管一件事</h3>
          <div class="kit-badges">
            <StatusBadge status="confirmed" label="key" />
            <StatusBadge status="pending" label="warn" />
            <StatusBadge status="soon" label="note" />
          </div>
          <p class="kit-muted">key 放结论，warn 放边界，note 放补充说明。三者不混用。</p>
        </div>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="kit-callout-title">
      <SectionHeader number="02" eyebrow="CALLOUT" title="把边界说在前面" headingId="kit-callout-title" description="参考页最值得借鉴的不是装饰，而是把结论、依据和限制分开写。">
        <StatusBadge status="confirmed" label="已落地" />
      </SectionHeader>

      <Callout tone="key" title="先确认，再决定">
        <p>价格、课期、地点与包含范围，以各自已确认的信息为准。没有公开信息，不代表免费、不代表默认存在，也不代表没有限制。</p>
      </Callout>
      <Callout tone="warn" title="不要把这些数字当报价">
        <p>页面里的数字只用于说明判断方法或公开参考区间，不是报价单。具体费用、优惠和有效期，需要另行核对。</p>
      </Callout>
      <Callout tone="note" title="内部预览">
        <p>这个页面用于检查编辑模块的实际效果，不加入公开页面清单，也不进入 sitemap。</p>
      </Callout>
    </section>

    <section class="kit-section" aria-labelledby="kit-compare-title">
      <SectionHeader number="03" eyebrow="COVER & COMPARISON" title="结论和边界，放在同一屏里" headingId="kit-compare-title" description="封面先给结论和 meta；双栏对比把“能做什么”和“不替代什么”并排放。" />
      <ComparisonBlock
        left={{ eyebrow: '值得借鉴', title: '先给结论，再给证据', body: '参考页把结论、依据、边界分层写，读者可以只看结论，也可以继续往下核对。' }}
        right={{ eyebrow: '不要照搬', title: '红黑配色和密集小字', body: '贝缇继续用宋体、米色、深绿和金色；字号、行距和留白按品牌站的标准来。' }}
      />
      <div class="kit-spacer"></div>
      <ComparisonBlock
        left={{ eyebrow: '这篇会帮你', title: '建立一个判断框架', body: '知道该问什么、该核对什么，读完能带走一个动作，而不是只记住几句口号。' }}
        right={{ eyebrow: '这篇不替代', title: '具体服务与预约确认', body: '服务内容、价格、地点和预约安排，仍需按各自已确认的信息另行核对。' }}
      />
    </section>

    <section class="kit-section" aria-labelledby="kit-typography-title">
      <SectionHeader number="04" eyebrow="ARTICLE TYPOGRAPHY" title="文章正文，能读也能扫" headingId="kit-typography-title" description="标题用宋体，正文用无衬线；列表、引用、表格和重点句各有明确的层级。" />
      <div class="kit-prose">
        <p>先说结论：一篇文章值不值得读，不看它写得多长，而看它有没有直接回答、有没有说明依据、有没有把边界讲清楚。</p>
        <h2>先看结论：它有没有直接回答</h2>
        <p>标题问什么，第一段就应该回答什么。如果一篇文章花了很长篇幅讲品牌故事，却迟迟不回答标题里的问题，阅读成本就会变高。</p>
        <h3>结论在前，还是铺垫在前</h3>
        <p>可以直接看第一段有没有出现明确判断。比如“零基础可以学，但要先确认时间投入”是判断；“美业是一个充满机遇的行业”不是判断。</p>
        <ul>
          <li>统计时间是什么时候；</li>
          <li>统计范围是哪个城市、哪类课程；</li>
          <li>数字包含什么、不包含什么。</li>
        </ul>
        <blockquote>
          <p>一篇文章的价值，不在于它说得多满，而在于它愿不愿意把边界说清楚。</p>
        </blockquote>
        <h2>一张对照表</h2>
        <div class="kit-table-wrap">
          <table class="kit-table">
            <thead><tr><th>模块</th><th>主要用法</th><th>状态</th><th>备注</th></tr></thead>
            <tbody>
              <tr><td>章节标题</td><td>长页面建立节奏</td><td><StatusBadge status="confirmed" label="已落地" /></td><td>编号 + eyebrow + 标题</td></tr>
              <tr><td>提示块</td><td>结论、边界、补充说明</td><td><StatusBadge status="confirmed" label="已落地" /></td><td>key / warn / note</td></tr>
              <tr><td>状态徽标</td><td>信息成熟度</td><td><StatusBadge status="pending" label="待确认" /></td><td>不写成已确认</td></tr>
              <tr><td>封面</td><td>结论 + meta</td><td><StatusBadge status="confirmed" label="已落地" /></td><td>文章页与样例页</td></tr>
            </tbody>
          </table>
        </div>
        <p><strong>重点句</strong>用淡金色底纹，<em>补充说明</em>用金色斜体；表格数字使用等宽数字，手机端在容器内横向滚动。</p>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="kit-qa-title">
      <SectionHeader number="05" eyebrow="QA & PRINT" title="读完能问，也能带走" headingId="kit-qa-title" description="问答块负责收尾，打印版式负责把同一套内容带到线下。" />
      <QaBlock
        headingId="kit-qa-block-title"
        title="读完之后，还有疑问？"
        items={[
          { q: '这些模块只能用在文章页吗？', a: '不是。章节标题、提示块和状态徽标可以用在服务、培训、价格和咨询页；封面和问答更适合长页面。' },
          { q: '未确认的信息怎么展示？', a: '用“待确认”或“以官方公布为准”明确标出，不把占位内容写成确定事实。' },
          { q: '打印版会保留什么？', a: '保留标题、正文、表格和更新日期，隐藏导航、目录、按钮和页脚。' }
        ]}
      />
      <div class="kit-print-row">
        <PrintButton label="打印这一页" />
        <span class="kit-muted">打印时自动隐藏导航、目录和按钮，保留正文、表格与更新日期。</span>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="kit-live-title">
      <SectionHeader number="06" eyebrow="LIVE REFERENCE" title="线上参考页，实际看到了什么" headingId="kit-live-title" description="2026-11-19 实际打开 geo.newrank.cn/news/8417：正文 736px、标题 28px、正文 14px、全宽图片、无目录、底部有上一篇/下一篇和相关推荐。" />
      <div class="kit-table-wrap">
        <table class="kit-table">
          <thead><tr><th>线上做法</th><th>观察</th><th>贝缇落地</th><th>状态</th></tr></thead>
          <tbody>
            <tr><td>正文宽度</td><td>736px</td><td>760px 正文栏</td><td><StatusBadge status="confirmed" label="已借鉴" /></td></tr>
            <tr><td>标题 / 正文</td><td>28px / 14px</td><td>保留品牌大标题，正文 16px</td><td><StatusBadge status="soon" label="不照搬" /></td></tr>
            <tr><td>图片</td><td>全宽、无说明、alt 为空</td><td>全宽 hero + alt + figcaption</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>目录</td><td>没有目录</td><td>h2/h3 目录，桌面 sticky、手机折叠</td><td><StatusBadge status="confirmed" label="增强" /></td></tr>
            <tr><td>翻页</td><td>上一篇 / 下一篇</td><td>文章底部 pager</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>相关</td><td>相关推荐列表</td><td>同主题草稿 / 继续阅读</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
          </tbody>
        </table>
      </div>
      <Callout tone="note" title="只借结构，不照搬版式">
        <p>线上文章是图片为主的导流页，14px 正文和 28px 标题不适合贝缇品牌站。我们只借鉴阅读宽度、全宽图片、翻页和相关推荐；目录和图片说明是额外增强。</p>
      </Callout>
      <div class="kit-actions"><a class="text-link" href="https://geo.newrank.cn/news/8417" target="_blank" rel="noopener noreferrer">查看线上参考文章 ↗</a></div>
    </section>

    <section class="kit-section" aria-labelledby="kit-status-title">
      <SectionHeader number="07" eyebrow="MODULE STATUS" title="模块清单" headingId="kit-status-title" description="每个模块都有对应的实际页面；未确认的内容保持占位，不提前写成确定事实。" />
      <div class="kit-table-wrap">
        <table class="kit-table">
          <thead><tr><th>模块</th><th>对应页面 / 场景</th><th>状态</th></tr></thead>
          <tbody>
            <tr><td>SectionHeader</td><td>本页 01–06 节</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>Callout</td><td>本页边界说明、文章页结论区</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>StatusBadge</td><td>本页状态说明、模块清单</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>CoverBlock</td><td>本页顶部封面</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>ComparisonBlock</td><td>本页 03 节双栏对比</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>QaBlock</td><td>本页 05 节问答</td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>文章目录 / 正文排版</td><td><a class="text-link" href="/articles/preview-article-typography/">文章样例</a></td><td><StatusBadge status="confirmed" label="已落地" /></td></tr>
            <tr><td>真实课程与价格数据</td><td>等待事实确认</td><td><StatusBadge status="pending" label="待确认" /></td></tr>
          </tbody>
        </table>
      </div>
      <div class="kit-actions">
        <a class="button" href="/articles/preview-article-typography/">查看文章样例</a>
        <a class="text-link" href="/services/">返回服务信息</a>
        <a class="text-link" href="/contact/">整理问题</a>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="kit-inventory-title">
      <SectionHeader number="08" eyebrow="CONTENT INVENTORY" title="素材库，还没到发布状态" headingId="kit-inventory-title" description="18 篇行业草稿 + 3 篇站点操作稿按主题簇分组；未确认事实不写成已确认。" />
      <div class="kit-table-wrap">
        <table class="kit-table">
          <thead><tr><th>主题簇</th><th>篇数</th><th>代表问题</th><th>当前状态</th></tr></thead>
          <tbody>
            <tr><td>选校与学习路径</td><td>7</td><td>怎么选学校、学徒还是培训班、多久能学会</td><td><StatusBadge status="pending" label="待整理" /></td></tr>
            <tr><td>费用与合同</td><td>4</td><td>学费、工具费、合同、包教包会</td><td><StatusBadge status="pending" label="待确认" /></td></tr>
            <tr><td>职业与经营</td><td>5</td><td>收入、接单、开店成本、证照、35 岁转行</td><td><StatusBadge status="pending" label="待确认" /></td></tr>
            <tr><td>技术方向</td><td>2</td><td>日式与俄式、美甲美睫一起学</td><td><StatusBadge status="conditional" label="可合并" /></td></tr>
            <tr><td>站点操作</td><td>3</td><td>如何了解服务、地点与评价</td><td><StatusBadge status="local" label="已有 pending 稿" /></td></tr>
          </tbody>
        </table>
      </div>
      <Callout tone="note" title="发布前还要做什么">
        <p>18 篇行业草稿和 3 篇站点操作稿只作为素材，当前没有改动正文和结论。正式发布前需要逐条核实事实，并把“待确认”改成已确认信息或明确占位。</p>
      </Callout>
      <div class="kit-actions">
        <a class="button" href="/articles/preview/">打开全部草稿预览</a>
        <a class="text-link" href="/articles/">查看已确认文章</a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .kit-page { max-width: 1180px; }
  .kit-cover-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 20px; }
  .kit-toc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 18px; margin: 0 0 8px; padding: 20px 24px; border: 1px solid var(--line); background: #faf7f1; }
  .kit-toc a { padding: 4px 0; color: #3c3730; font-size: 14px; text-decoration: none; border-bottom: 1px solid transparent; }
  .kit-toc a:hover { color: var(--gold-dark); border-color: var(--gold-dark); }
  .kit-toc span { margin-right: 8px; color: var(--gold-dark); font-weight: 600; font-variant-numeric: tabular-nums; }
  .kit-section { padding: clamp(48px, 6vw, 80px) 0; border-top: 1px solid var(--line); }
  .kit-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .kit-grid--spaced { margin-top: 24px; }
  .kit-card { padding: clamp(22px, 3vw, 30px); border: 1px solid var(--line); background: #fbf9f3; }
  .kit-card h3 { margin: 0 0 14px; font-family: var(--serif); font-size: clamp(21px, 2.4vw, 26px); font-weight: 400; line-height: 1.5; }
  .kit-card .section-header { margin-bottom: 24px; }
  .kit-badges { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
  .kit-muted { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .kit-spacer { height: 20px; }

  .kit-prose { max-width: 760px; font-size: 16px; line-height: 1.95; color: var(--ink); }
  .kit-prose p { margin: 0 0 1.15rem; }
  .kit-prose h2 { position: relative; margin: 2.8rem 0 1.1rem; padding: 1.3rem 0 0 1.1rem; border-top: 1px solid var(--line); font-family: var(--serif); font-size: clamp(25px, 2.8vw, 32px); font-weight: 400; line-height: 1.45; }
  .kit-prose h2::before { content: ""; position: absolute; left: 0; top: 1.45rem; width: 4px; height: 1.05em; background: var(--gold); }
  .kit-prose h3 { margin: 2rem 0 .8rem; font-size: 19px; font-weight: 600; line-height: 1.6; }
  .kit-prose h3::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 10px; background: var(--gold-dark); vertical-align: middle; }
  .kit-prose ul { margin: 0 0 1.4rem; padding-left: 1.4rem; }
  .kit-prose li { margin: .4rem 0; }
  .kit-prose li::marker { color: var(--gold-dark); }
  .kit-prose blockquote { margin: 1.8rem 0; padding: 1.2rem 1.5rem; border-left: 3px solid var(--gold-dark); background: #f3ecdc; color: #3f4a44; }
  .kit-prose blockquote p { margin: 0; font-family: var(--serif); font-size: 17px; line-height: 1.9; }
  .kit-prose strong { font-weight: 600; background: linear-gradient(transparent 62%, rgb(220 200 166 / 52%) 62%); }
  .kit-prose em { color: var(--gold-dark); }

  .kit-table-wrap { overflow-x: auto; margin: 1.6rem 0 1.2rem; border: 1px solid var(--line); background: #fbf9f3; -webkit-overflow-scrolling: touch; }
  .kit-table { width: 100%; min-width: 40rem; border-collapse: separate; border-spacing: 0; font-size: 14.5px; line-height: 1.7; }
  .kit-table th { padding: 12px 14px; background: #e9e4d6; border-bottom: 1px solid var(--line); font-weight: 600; text-align: left; white-space: nowrap; }
  .kit-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; font-variant-numeric: tabular-nums; }
  .kit-table tbody tr:nth-child(even) { background: rgb(238 234 223 / 55%); }
  .kit-table tbody tr:last-child td { border-bottom: 0; }

  .kit-print-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 22px; }
  .kit-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin-top: 28px; }

  @media (max-width: 760px) {
    .kit-grid { grid-template-columns: minmax(0, 1fr); }
    .kit-toc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .kit-toc { grid-template-columns: minmax(0, 1fr); }
  }
  @media print {
    :global(body) { padding-top: 0 !important; background: #fff !important; color: #000 !important; }
    :global(.site-header), :global(.site-footer), :global(.breadcrumbs), :global(.skip-link) { display: none !important; }
    .kit-page { max-width: none; }
    .kit-section { padding: 18pt 0; border-top: 1px solid #999; }
    .kit-grid, .kit-cover-actions, .kit-actions, .kit-print-row { display: none !important; }
    .kit-card, .kit-table-wrap, .kit-prose blockquote { background: #f4f4f4 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .kit-table { min-width: 0; font-size: 9pt; }
