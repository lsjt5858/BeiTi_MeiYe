---
import InnerPage from './_shared/InnerPage.astro';
import { site, getLocations, getContactPhone } from '../lib/content.ts';
import { getAboutDetails } from './_shared/about.ts';
import { getAcademyProfile } from '../lib/training.ts';
import { localeFromPath, translate } from '../lib/i18n.ts';
import TeacherProfile from '../components/TeacherProfile.astro';
const { organization, team, teachingRoles, qualifications, registration } = getAboutDetails();
const campus = getLocations()[0];
const { display: phone, tel } = getContactPhone();
const profile = getAcademyProfile();
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const tr = (text: string) => translate(text, locale);
---
<InnerPage title={en ? 'Teaching starts with the person.' : '以人为本，致力于教。'} eyebrow="About / 关于贝缇" description={profile ? tr(profile.description) : `${site.brand}在这个网站上坚持一件事：先把信息说清楚，再让您做选择。`} breadcrumbs={[{ label: '关于贝缇' }]}>
  <section class="editorial-section">
    <p class="eyebrow">{profile ? tr(profile.name) : site.brand}</p>
    <h2>{en ? 'Read the details.' : '看懂细节，'}<br />{en ? 'Build the skill.' : '把练习落到手上。'}</h2>
    <p class="intro-copy">{en ? 'Look through the nail, lash and salon-operation outlines before choosing. Bring your previous experience and the specific points you want to practise, then compare what each course covers.' : '美甲、美睫和店务运营，先看内容，再选方向。带着自己的基础和想补的技术点来比较课程，知道哪些用得上，也知道下一步该问什么。'}</p>
  </section>
  {profile && teachingRoles.length === 0 && <section class="editorial-section" aria-labelledby="teaching-focus-heading">
    <p class="eyebrow">TEACHING FOCUS</p>
    <h2 id="teaching-focus-heading">{en ? 'Different areas of teaching' : '不同方向，各有关注的细节'}</h2>
    <ul class="editorial-list">{profile.specialties.map((specialty, i) => <li class="editorial-row"><div><span class="row-number">{String(i + 1).padStart(2, '0')}</span><h3>{tr(specialty.name)}</h3></div><p>{tr(specialty.detail)}</p></li>)}</ul>
    <a class="text-link" href="/training/">{en ? 'Read the course outlines' : '对照课程内容'} <span aria-hidden="true">→</span></a>
  </section>}
  {campus && <section class="editorial-section" aria-labelledby="campus-heading">
    <h2 id="campus-heading">校区在哪里</h2>
    <p class="intro-copy">杭州校区在拱墅区兴业街29号 金通数字经济科创园16幢，地铁 4 号线华中南路站 E 口。</p>
    {phone && <p class="intro-copy">咨询电话：{tel ? <a class="text-link" href={`tel:${tel}`}>{phone}</a> : <span>{phone}</span>}</p>}
    <div class="page-actions"><a class="text-link" href="/locations/">查看校区地址与到访说明 <span aria-hidden="true">→</span></a></div>
  </section>}
  <section class="editorial-section" aria-labelledby="practice-heading">
    <h2 id="practice-heading">先看懂，再上手</h2>
    <div class="technique-pair">
      <figure>
        <img src="/images/technique/nail-structure-before-prep.jpg" alt="前置处理前观察指甲结构，品牌视觉示意，不是学员或客户成果" width="1600" height="900" loading="lazy" decoding="async" />
        <figcaption>前置，从看懂结构开始 · 品牌视觉示意</figcaption>
      </figure>
      <figure>
        <img src="/images/technique/lash-tweezer-support.jpg" alt="持镊练习与手部支撑，品牌视觉示意，不是学员或客户成果" width="1600" height="900" loading="lazy" decoding="async" />
        <figcaption>持镊，先稳住支撑 · 品牌视觉示意</figcaption>
      </figure>
    </div>
  </section>
  {organization && <section class="editorial-section" aria-labelledby="organization-heading">
    <h2 id="organization-heading">{en ? 'Organization' : '机构信息'}</h2>
    <h3>{organization.name}</h3>
    {organization.description && <p class="intro-copy">{organization.description}</p>}
    {organization.legalName && <dl class="fact-grid"><div><dt>登记名称</dt><dd>{organization.legalName}</dd></div></dl>}
    {organization.website && <a class="text-link" href={organization.website} target="_blank" rel="noopener noreferrer">查看实体网站（新窗口）</a>}
  </section>}
  {(team.length > 0 || teachingRoles.length > 0) && <section class="editorial-section" aria-labelledby="team-heading">
    <p class="eyebrow">PEOPLE & TEACHING</p>
    <h2 id="team-heading">{en ? 'Teachers and teaching areas' : '老师与教学方向'}</h2>
    {team.length > 0 && <ul class="teacher-list">{team.map(member => <TeacherProfile member={member} />)}</ul>}
    {teachingRoles.length > 0 && <ul class="teacher-list teacher-role-list">{teachingRoles.map(member => <TeacherProfile member={member} />)}</ul>}
  </section>}
  {qualifications.length > 0 && <section class="editorial-section" aria-labelledby="qualifications-heading">
    <p class="eyebrow">NAIL CREDENTIALS</p>
    <h2 id="qualifications-heading">{en ? 'Nail instructor credentials' : '美甲师资认证'}</h2>
    <ul class="editorial-list">{qualifications.map((qualification) => <li class="editorial-row">
      <h3>{tr(qualification.name)}</h3>
      <div>
        {qualification.description && <p>{tr(qualification.description)}</p>}
        {qualification.issuer && <p>{en ? 'Issuing body: ' : '颁发机构：'}{tr(qualification.issuer)}</p>}
        {qualification.date && <p class="meta">{en ? 'Document date: ' : '资料日期：'}<time datetime={qualification.date}>{qualification.date}</time></p>}
        {qualification.sourceUrl && <a class="text-link" href={qualification.sourceUrl} target="_blank" rel="noopener noreferrer">{en ? 'Check credential source' : '核对资质来源'} <span aria-hidden="true">↗</span></a>}
      </div>
    </li>)}</ul>
  </section>}
  {registration && <section class="editorial-section" aria-labelledby="registration-heading">
        <h2 id="registration-heading">{en ? 'Registration' : '登记信息'}</h2>
        <div><dl class="fact-grid"><div><dt>{registration.label || '登记编号'}</dt><dd>{registration.number}</dd></div>{registration.authority && <div><dt>登记机构</dt><dd>{registration.authority}</dd></div>}</dl>
          {registration.sourceUrl && <a class="text-link" href={registration.sourceUrl} target="_blank" rel="noopener noreferrer">核对登记来源（新窗口）</a>}
        </div>
  </section>}
  <section class="editorial-section"><h2>还有哪些事，您想了解？</h2><div class="page-actions"><a class="button" href="/contact/">把想了解的事写下来</a><a class="text-link" href="/terms/">阅读网站使用说明</a></div></section>
</InnerPage>
