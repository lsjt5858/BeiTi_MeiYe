---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getArticles, getLatestUpdate } from '../../lib/content.ts';
import { articleGroups } from '../../lib/draft-groups.ts';
import { localeFromPath } from '../../lib/i18n.ts';
import { safeSlug } from '../_shared/values.ts';

const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const articles = getArticles();
const bySlug = new Map(articles.map((article) => [article.slug, article]));
const latest = getLatestUpdate();
const categoryIds = ['school', 'cost', 'career', 'technique', 'craft'];
const categoryEnglish: Record<string, { title: string; description: string }> = {
  school: { title: 'School & learning', description: 'Comparing schools, apprenticeships, study timelines, weekend classes and online versus offline courses.' },
  cost: { title: 'Cost & contract', description: 'Tuition structure, tool costs, contract terms and how to check a “learn until you can” promise.' },
  career: { title: 'Career & business', description: 'Income structure, client acquisition, opening costs, licensing and career-change paths.' },
  technique: { title: 'Technique', description: 'Japanese versus Russian nails, and whether to learn nails and lashes together.' },
  craft: { title: 'Craft notes', description: 'Nail and lash observation, practice order and common deviations, one technical point per article.' },
};

const categories = articleGroups.map((group, index) => {
  const id = categoryIds[index] ?? `group-${index}`;
  return {
    id,
    title: group.title,
    titleEn: categoryEnglish[id]?.title ?? group.title,
    description: group.description,
    descriptionEn: categoryEnglish[id]?.description ?? group.description,
    count: group.slugs.filter((slug) => bySlug.has(slug)).length,
  };
});
const categoryBySlug = new Map<string, string>();
articleGroups.forEach((group, index) => {
  const id = categoryIds[index] ?? `group-${index}`;
  group.slugs.forEach((slug) => categoryBySlug.set(slug, id));
});
const orderedFromGroups = articleGroups.flatMap((group) => group.slugs.flatMap((slug) => {
  const article = bySlug.get(slug);
  return article ? [article] : [];
}));
const groupedSlugs = new Set(orderedFromGroups.map((article) => article.slug));
const ungrouped = articles.filter((article) => !groupedSlugs.has(article.slug));
const listArticles = [...orderedFromGroups, ...ungrouped];
if (ungrouped.length > 0) {
  categories.push({
    id: 'more',
    title: '更多文章',
    titleEn: 'More articles',
    description: '其他已确认发布的文章。',
    descriptionEn: 'Other published articles.',
    count: ungrouped.length,
  });
  ungrouped.forEach((article) => categoryBySlug.set(article.slug, 'more'));
}
const categoryById = new Map(categories.map((category) => [category.id, category]));

const topicDefinitions = [
  { id: 'beginner', title: '零基础入门', titleEn: 'Starting from zero', slugs: ['how-to-choose-nail-school', 'hangzhou-nail-training-where-good', 'how-long-to-learn-nail', 'nail-school-checklist', 'apprentice-vs-nail-school'] },
  { id: 'school', title: '选校避坑', titleEn: 'Choosing a school', slugs: ['how-to-choose-nail-school', 'hangzhou-nail-training-where-good', 'apprentice-vs-nail-school', 'nail-school-checklist', 'hangzhou-weekend-nail-class'] },
  { id: 'cost', title: '学费与预算', titleEn: 'Tuition & budget', slugs: ['hangzhou-nail-training-price', 'nail-training-cost-framework', 'nail-starter-tool-kit-cost'] },
  { id: 'contract', title: '合同与复训', titleEn: 'Contracts & retraining', slugs: ['nail-training-contract-checklist', 'nail-training-until-learned', 'nail-training-cost-framework'] },
  { id: 'hangzhou', title: '杭州学习', titleEn: 'Studying in Hangzhou', slugs: ['hangzhou-nail-training-price', 'hangzhou-nail-training-where-good', 'hangzhou-weekend-nail-class', 'career-change-nail-hangzhou'] },
  { id: 'career-change', title: '转行与年龄', titleEn: 'Career change & age', slugs: ['career-change-nail-hangzhou', 'learn-nail-at-35', 'apprentice-vs-nail-school'] },
  { id: 'income', title: '收入与接单', titleEn: 'Income & clients', slugs: ['nail-technician-monthly-income', 'nail-income-framework', 'where-to-get-nail-clients'] },
  { id: 'salon', title: '开店与证照', titleEn: 'Opening a salon', slugs: ['how-much-to-open-nail-salon', 'open-nail-salon-license'] },
  { id: 'flexible', title: '周末与线上', titleEn: 'Weekends & online', slugs: ['hangzhou-weekend-nail-class', 'online-vs-offline-nail-course'] },
  { id: 'technique', title: '日式与俄式', titleEn: 'Japanese & Russian', slugs: ['japanese-vs-russian-nail', 'nail-and-lash-together'] },
  { id: 'nail-craft', title: '美甲技法', titleEn: 'Nail craft', slugs: ['nail-shape-three-views', 'nail-structure-before-prep', 'dry-wet-nail-prep', 'russian-prep-safe-pocket', 'nail-tool-maintenance', 'solid-color-even-coating', 'nail-color-clean-margins', 'nail-structure-light-reflection', 'tips-vs-gel-extension', 'paper-form-alignment', 'shallow-tips-position', 'almond-oval-tips', 'square-tube-c-curve', 'extension-gel-bubbles', 'airbrush-soft-gradient'] },
  { id: 'lash-craft', title: '美睫技法', titleEn: 'Lash craft', slugs: ['round-flat-lash-selection', 'lash-curl-jbcd', 'lash-root-tip-curl', 'lash-tweezer-support', 'lash-straight-line-view', 'lash-adhesion-ab-points', 'lash-glue-working-time', 'lash-root-gaps-shape', 'lash-contour-framework-fill', 'lash-length-point-map', 'tassel-lash-layer-spacing', 'manga-lash-column-three-lines', 'fox-lash-tail-flow', 'natural-lashes-space-color', 'lash-design-open-eye-review'] },
];
const topics = topicDefinitions
  .map((topic) => ({ ...topic, count: topic.slugs.filter((slug) => bySlug.has(slug)).length }))
  .filter((topic) => topic.count > 0);
const topicsFor = (slug: string) => topics.filter((topic) => topic.slugs.includes(slug));

function firstImage(body: string) {
  const match = /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/.exec(body);
  return match ? { alt: match[1] ?? '', src: match[2] ?? '' } : null;
}

const title = '文章与解答';
const description = en
  ? `A journal of ${articles.length} long-form articles on choosing a nail school, costs, learning paths, careers and salon operations. Each starts with a conclusion, then explains the reasoning, limits and what to check.`
  : `围绕选校、费用、学习路径、职业与经营整理的 ${articles.length} 篇文章。每篇先给结论，再拆依据、边界和可执行的核对清单。`;
const pageSize = 6;
---

<SiteLayout title={en ? 'Journal' : title} description={description}>
  <div class="journal-page">
    <p class="visually-hidden"><time datetime={latest}>{latest}</time></p>
    <header class="journal-hero">
      <div class="journal-container">
        <nav class="journal-crumb" aria-label={en ? 'Breadcrumbs' : '面包屑'}>
          <a href="/"><span aria-hidden="true">←</span>{en ? 'Home' : '首页'}</a>
          <span class="journal-crumb-sep" aria-hidden="true">/</span>
          <span class="journal-crumb-current" aria-current="page">{en ? 'Journal' : title}</span>
        </nav>

        <div class="journal-hero-grid">
          <div class="journal-hero-copy">
            <p class="eyebrow">{en ? 'Journal / Articles & answers' : 'Journal / 文章与解答'}</p>
            <h1>{en ? 'Journal' : title}</h1>
            <p class="journal-subtitle">{en ? 'Good questions deserve time.' : '有问题，就慢慢读。'}</p>
          </div>
          <div class="journal-hero-aside">
            <p class="journal-lede">{description}</p>
            <div class="journal-stats">
              <span><strong>{articles.length}</strong>{en ? ' articles' : ' 篇文章'}</span>
              <span><strong>{categories.length}</strong>{en ? ' categories' : ' 个分类'}</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="journal-container journal-mobile-filter">
      <label class="journal-select">
        <span class="journal-select-label">{en ? 'Category' : '分类'}</span>
        <span class="journal-select-control">
          <select data-category-select aria-label={en ? 'Filter articles by category' : '按分类筛选文章'}>
            <option value="all">{en ? `All articles (${articles.length})` : `全部文章（${articles.length}）`}</option>
            {categories.map((category) => <option value={category.id}>
              {en ? `${category.titleEn} (${category.count})` : `${category.title}（${category.count}）`}
            </option>)}
          </select>
        </span>
      </label>
    </div>

    <div
      class="journal-container journal-shell"
      data-journal
      data-page-size={pageSize}
      data-locale={en ? 'en' : 'zh'}
    >
      <aside class="journal-side journal-side--categories" aria-labelledby="journal-categories-title">
        <p class="journal-side-kicker">CATEGORIES</p>
        <h2 class="journal-side-title" id="journal-categories-title">{en ? 'Browse by type' : '分类浏览'}</h2>
        <ul class="journal-categories">
          <li>
            <button type="button" class="journal-cat" data-category="all" data-label={en ? 'All articles' : '全部文章'} aria-pressed="true">
              <span class="journal-cat-index">00</span>
              <span class="journal-cat-label">{en ? 'All articles' : '全部文章'}</span>
              <span class="journal-cat-count">{articles.length}</span>
            </button>
          </li>
          {categories.map((category, index) => <li>
            <button type="button" class="journal-cat" data-category={category.id} data-label={en ? category.titleEn : category.title} aria-pressed="false">
              <span class="journal-cat-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="journal-cat-label">{en ? category.titleEn : category.title}</span>
              <span class="journal-cat-count">{category.count}</span>
            </button>
          </li>)}
        </ul>
        <p class="journal-side-note">{en ? 'Choose a type to narrow the list. Topics on the right cut across all types.' : '先按类型缩小范围，右侧议题可以跨分类查看。'}</p>
      </aside>

      <section class="journal-main" aria-labelledby="journal-list-title">
        <div class="journal-toolbar">
          <h2 class="journal-list-title" id="journal-list-title">{en ? 'All articles' : '全部文章'}</h2>
          <p class="journal-result" aria-live="polite">
            <strong data-result-count>{articles.length}</strong>
            <span>{en ? ' articles' : ' 篇'}</span>
            <span class="journal-filter-note" data-filter-note hidden>· {en ? 'filtered' : '已筛选'}</span>
          </p>
        </div>

        <div class="journal-active" data-active-filters hidden>
          <span class="journal-active-label">{en ? 'Filtered by' : '当前筛选'}</span>
          <button type="button" class="journal-active-chip" data-clear-category hidden>
            <span data-active-category></span><span aria-hidden="true">×</span>
          </button>
          <button type="button" class="journal-active-chip" data-clear-topic hidden>
            <span data-active-topic></span><span aria-hidden="true">×</span>
          </button>
          <button type="button" class="journal-clear-all" data-clear-all>{en ? 'Clear all' : '清除全部'}</button>
        </div>

        <div class="journal-list" data-article-list>
          {listArticles.map((article, index) => {
            const category = categoryById.get(categoryBySlug.get(article.slug) ?? 'more') ?? categories[0];
            const image = firstImage(article.body);
            const itemTopics = topicsFor(article.slug).slice(0, 3);
            const itemTopicIds = topicsFor(article.slug).map((topic) => topic.id).join(' ');
            return <article
              class="journal-item"
              data-article-item
              data-category={category?.id ?? 'more'}
              data-topics={itemTopicIds}
            >
              <div class="journal-item-body">
                <p class="journal-item-meta">
                  <span class="journal-item-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="journal-item-category">{en ? category?.titleEn : category?.title}</span>
                  <time datetime={article.updatedAt}>{article.updatedAt.slice(0, 10)}</time>
                </p>
                <h3 class="journal-item-title">
                  <a href={`/articles/${safeSlug(article.slug)}/`}>{article.title}</a>
                </h3>
                <p class="journal-item-desc">{article.description}</p>
                <div class="journal-item-foot">
                  {itemTopics.length > 0 && <ul class="journal-item-topics">
                    {itemTopics.map((topic) => <li>
                      <button type="button" class="journal-item-topic" data-topic={topic.id} data-label={en ? topic.titleEn : topic.title}>
                        {en ? topic.titleEn : topic.title}
                      </button>
                    </li>)}
                  </ul>}
                  <a class="journal-item-read" href={`/articles/${safeSlug(article.slug)}/`}>
                    {en ? 'Read' : '阅读全文'} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
              {image?.src && <a class="journal-item-media" href={`/articles/${safeSlug(article.slug)}/`} tabindex="-1" aria-hidden="true">
                <img src={image.src} alt="" loading="lazy" decoding="async" />
              </a>}
            </article>;
          })}
        </div>

        <div class="journal-empty" data-empty hidden>
          <p class="eyebrow">NO RESULTS</p>
          <h3>{en ? 'No matching articles' : '没有匹配的文章'}</h3>
          <p>{en ? 'Try another category or topic, or clear the filters to see all articles.' : '换个分类或议题试试，也可以清除筛选查看全部文章。'}</p>
          <button type="button" class="button-secondary journal-empty-reset" data-clear-all>{en ? 'Show all articles' : '查看全部文章'}</button>
        </div>

        <noscript>
          <p class="journal-noscript">{en ? 'All articles are listed above. Filters and pagination require JavaScript.' : '全部分章已按顺序列在上方；分类筛选与分页需要浏览器启用 JavaScript。'}</p>
        </noscript>

        <nav
          class="journal-pagination"
          data-pagination
          aria-label={en ? 'Article pagination' : '文章分页'}
          data-label-prev={en ? 'Previous page' : '上一页'}
          data-label-next={en ? 'Next page' : '下一页'}
          data-label-page={en ? 'Page {n}' : '第 {n} 页'}
          hidden
        ></nav>
      </section>

      <aside class="journal-side journal-side--topics" aria-labelledby="journal-topics-title">
        <p class="journal-side-kicker">TOPICS</p>
        <h2 class="journal-side-title" id="journal-topics-title">{en ? 'Frequent topics' : '高频议题'}</h2>
        <div class="journal-topics">
          {topics.map((topic) => <button
            type="button"
            class="journal-topic"
            data-topic={topic.id}
            data-label={en ? topic.titleEn : topic.title}
            aria-pressed="false"
          >
            <span>{en ? topic.titleEn : topic.title}</span>
            <span class="journal-topic-count">{topic.count}</span>
          </button>)}
        </div>
        <div class="journal-aside-card">
          <p class="eyebrow">START HERE</p>
          <p>{en ? 'Not sure where to begin? Start with the school checklist, then confirm cost, contract and schedule item by item.' : '不确定从哪篇开始？先看选校核对清单，再按费用、合同和时间安排逐项确认。'}</p>
          <a class="text-link" href="/articles/nail-school-checklist/">{en ? 'Start with the checklist' : '从选校清单开始'} <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </div>
</SiteLayout>

<script>
  const journal = document.querySelector<HTMLElement>('[data-journal]');
  if (journal) {
    const items = Array.from(journal.querySelectorAll<HTMLElement>('[data-article-item]'));
    const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-category]'));
    const topicButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]'));
    const categorySelect = document.querySelector<HTMLSelectElement>('[data-category-select]');
    const list = journal.querySelector<HTMLElement>('[data-article-list]');
    const pagination = journal.querySelector<HTMLElement>('[data-pagination]');
    const count = journal.querySelector<HTMLElement>('[data-result-count]');
    const filterNote = journal.querySelector<HTMLElement>('[data-filter-note]');
    const activeBar = journal.querySelector<HTMLElement>('[data-active-filters]');
    const activeCategory = journal.querySelector<HTMLElement>('[data-active-category]');
    const activeTopic = journal.querySelector<HTMLElement>('[data-active-topic]');
    const clearCategory = journal.querySelector<HTMLButtonElement>('[data-clear-category]');
    const clearTopic = journal.querySelector<HTMLButtonElement>('[data-clear-topic]');
    const clearAllButtons = Array.from(journal.querySelectorAll<HTMLButtonElement>('[data-clear-all]'));
    const empty = journal.querySelector<HTMLElement>('[data-empty]');
    const pageSize = Number(journal.dataset.pageSize) || 6;
    const isEnglish = journal.dataset.locale === 'en';
    const categoryIds = new Set(categoryButtons.map((button) => button.dataset.category ?? ''));
    const topicIds = new Set(topicButtons.map((button) => button.dataset.topic ?? ''));
    const labelPrev = pagination?.dataset.labelPrev ?? (isEnglish ? 'Previous page' : '上一页');
    const labelNext = pagination?.dataset.labelNext ?? (isEnglish ? 'Next page' : '下一页');
    const labelPage = pagination?.dataset.labelPage ?? (isEnglish ? 'Page {n}' : '第 {n} 页');
    const state = { category: 'all', topic: '', page: 1 };

    function readUrl() {
      const params = new URLSearchParams(window.location.search);
      const category = params.get('category') ?? 'all';
      const topic = params.get('topic') ?? '';
      const page = Number(params.get('page') ?? '1');
      state.category = categoryIds.has(category) ? category : 'all';
      state.topic = topicIds.has(topic) ? topic : '';
      state.page = Number.isFinite(page) && page > 0 ? Math.floor(page) : 1;
    }

    function writeUrl(push: boolean) {
      const params = new URLSearchParams();
      if (state.category !== 'all') params.set('category', state.category);
      if (state.topic) params.set('topic', state.topic);
      if (state.page > 1) params.set('page', String(state.page));
      const url = `${window.location.pathname}${params.toString() ? `?${params}` : ''}`;
      const method = push ? 'pushState' : 'replaceState';
      window.history[method]({ ...state }, '', url);
    }

    function matches(item: HTMLElement) {
      const categoryMatch = state.category === 'all' || item.dataset.category === state.category;
      const topicMatch = !state.topic || (item.dataset.topics ?? '').split(' ').includes(state.topic);
      return categoryMatch && topicMatch;
    }

    function selectedLabel(selector: string, value: string) {
      const button = document.querySelector<HTMLButtonElement>(`button${selector}[data-${selector.includes('topic') ? 'topic' : 'category'}="${value}"]`);
      return button?.dataset.label ?? '';
    }

    function renderPagination(total: number, pages: number) {
      if (!pagination) return;
      pagination.replaceChildren();
      pagination.hidden = pages <= 1;
      if (pages <= 1) return;

      const add = (label: string, page: number, options: { current?: boolean; disabled?: boolean; arrow?: boolean; aria?: string } = {}) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `journal-page-btn${options.arrow ? ' journal-page-arrow' : ''}`;
        button.dataset.page = String(page);
        button.textContent = label;
        if (options.aria) button.setAttribute('aria-label', options.aria);
        if (options.current) button.setAttribute('aria-current', 'page');
        button.disabled = Boolean(options.disabled);
        pagination.append(button);
      };

      add('←', state.page - 1, { disabled: state.page === 1, arrow: true, aria: labelPrev });
      const numbers: (number | '…')[] = [];
      if (pages <= 7) {
        for (let page = 1; page <= pages; page += 1) numbers.push(page);
      } else {
        numbers.push(1);
        if (state.page > 4) numbers.push('…');
        const start = Math.max(2, state.page - 1);
        const end = Math.min(pages - 1, state.page + 1);
        for (let page = start; page <= end; page += 1) numbers.push(page);
        if (state.page < pages - 3) numbers.push('…');
        numbers.push(pages);
      }
      numbers.forEach((page) => {
        if (page === '…') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'journal-page-ellipsis';
          ellipsis.textContent = '…';
          ellipsis.setAttribute('aria-hidden', 'true');
          pagination.append(ellipsis);
          return;
        }
        add(String(page), page, { current: page === state.page, aria: labelPage.replace('{n}', String(page)) });
      });
      add('→', state.page + 1, { disabled: state.page === pages, arrow: true, aria: labelNext });
      pagination.dataset.total = String(total);
    }

    function render(options: { scroll?: boolean; push?: boolean } = {}) {
      const filtered = items.filter(matches);
      const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
      state.page = Math.min(Math.max(1, state.page), pages);
      const start = (state.page - 1) * pageSize;
      const visible = new Set(filtered.slice(start, start + pageSize));
      items.forEach((item) => { item.hidden = !visible.has(item); });

      if (count) count.textContent = String(filtered.length);
      if (filterNote) filterNote.hidden = state.category === 'all' && !state.topic;
      if (empty) empty.hidden = filtered.length > 0;
      if (list) list.hidden = filtered.length === 0;
      if (categorySelect) categorySelect.value = state.category;
      categoryButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === state.category)));
      topicButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.topic === state.topic)));

      const hasCategory = state.category !== 'all';
      const hasTopic = Boolean(state.topic);
      if (activeBar) activeBar.hidden = !hasCategory && !hasTopic;
      if (clearCategory) clearCategory.hidden = !hasCategory;
      if (clearTopic) clearTopic.hidden = !hasTopic;
      if (activeCategory && hasCategory) activeCategory.textContent = selectedLabel('[data-category]', state.category);
      if (activeTopic && hasTopic) activeTopic.textContent = selectedLabel('[data-topic]', state.topic);

      renderPagination(filtered.length, pages);
      writeUrl(Boolean(options.push));
      if (options.scroll) {
        const target = journal?.querySelector<HTMLElement>('.journal-main');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    }

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.category = button.dataset.category ?? 'all';
        state.topic = '';
        state.page = 1;
        render({ scroll: true, push: true });
      });
    });

    topicButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const topic = button.dataset.topic ?? '';
        if (state.topic === topic) {
          state.topic = '';
        } else {
          state.topic = topic;
          state.category = 'all';
        }
        state.page = 1;
        render({ scroll: true, push: true });
      });
    });

    categorySelect?.addEventListener('change', () => {
      state.category = categorySelect.value;
      state.topic = '';
      state.page = 1;
      render({ scroll: true, push: true });
    });

    clearCategory?.addEventListener('click', () => {
      state.category = 'all';
      state.page = 1;
      render({ scroll: true, push: true });
    });

    clearTopic?.addEventListener('click', () => {
      state.topic = '';
      state.page = 1;
      render({ scroll: true, push: true });
    });

    clearAllButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.category = 'all';
        state.topic = '';
        state.page = 1;
        render({ scroll: true, push: true });
      });
    });

    pagination?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-page]');
      if (!button || button.disabled) return;
      state.page = Number(button.dataset.page);
      render({ scroll: true, push: true });
    });

