---
import InnerPage from '../_shared/InnerPage.astro';
import { getArticles, getServices, getLocations, site } from '../../lib/content.ts';
import { safeSlug } from '../_shared/values.ts';
export function getStaticPaths() {
  return getArticles().map((article) => ({ params: { slug: safeSlug(article.slug) }, props: { article } }));
}
type Article = ReturnType<typeof getArticles>[number];
interface Props { article: Article }
const { article } = Astro.props;
const updatedAt = article.updatedAt || article.updated_at;
const services = getServices().filter((service) => article.fact_refs.includes(service.id));
const locations = getLocations().filter((location) => article.fact_refs.includes(location.id));
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: article.title, description: article.description,
  dateModified: updatedAt,
  publisher: { '@type': 'Organization', name: site.brand },
};
---
<InnerPage title={article.title} eyebrow="Journal / 问题解答" description={article.description} updatedAt={updatedAt} jsonLd={jsonLd} breadcrumbs={[{ label: '文章与解答', href: '/articles/' }, { label: article.title }]}>
  <article class="editorial-section">
    <p class="article-question"><span class="eyebrow">这篇文章回答</span><br />{article.question}</p>
    <div class="prose article-body" set:html={article.html} />
  </article>
  {(services.length > 0 || locations.length > 0) && <section class="editorial-section"><h2>与这篇文章有关的信息</h2><ul class="editorial-list">
    {services.map((service) => <li class="editorial-row"><h3><a class="text-link" href={`/services/${safeSlug(service.slug)}/`}>{service.name}</a></h3><p>查看这项服务已确认的适用范围、限制与计费说明。</p></li>)}
    {locations.map((location) => <li class="editorial-row"><h3><a class="text-link" href={`/locations/${safeSlug(location.slug)}/`}>{location.name}</a></h3><p>查看这个地点已确认的地址与到访说明。</p></li>)}
  </ul></section>}
  <section class="editorial-section"><h2>读完之后，还有疑问？</h2><p class="intro-copy">把问题和您已经了解的信息一起写下来。咨询摘要只在本地整理，不发送，也不代替具体服务确认。</p><div class="page-actions"><a class="button" href="/contact/">继续整理问题</a><a class="text-link" href="/articles/">返回全部文章</a></div></section>
</InnerPage>
<style>
  .article-question { line-height: 1.9; padding-bottom: 2rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--line, #d9d1c4); max-width: 48rem; }
  .article-body { max-width: 48rem; overflow-wrap: anywhere; }
  .article-body :global(img) { max-width: 100%; height: auto; }
  .article-body :global(pre) { overflow-x: auto; }
  .article-body :global(table) { display: block; overflow-x: auto; max-width: 100%; }
</style>
