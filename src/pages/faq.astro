---
import InnerPage from './_shared/InnerPage.astro';
import { getFaqs } from '../lib/content.ts';
const faqs = getFaqs();
const jsonLd = faqs.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question', name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
} : undefined;
---
<InnerPage title="咨询前须知" eyebrow="Before you ask / 咨询前须知" description="到店、联系、学习方向与价格，先看这几件小事。没写到的，以校区回复为准。" jsonLd={jsonLd} breadcrumbs={[{ label: '咨询前须知' }]}>
  <section class="editorial-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">先了解这几件事</h2>
    {faqs.length ? <div class="faq-list">
      {faqs.map((faq, index) => <details id={`faq-${index + 1}`} class="faq-item">
        <summary><span class="faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{faq.question}</span><span class="faq-toggle" aria-hidden="true">+</span></summary>
        <div class="faq-answer"><p>{faq.answer}</p></div>
      </details>)}
    </div> : <div class="empty-editorial empty-state"><h3>这部分内容正在整理。</h3><p>您可以先把问题写在咨询页，或浏览文章。</p></div>}
  </section>
  <section class="editorial-section" aria-labelledby="faq-reading-heading">
    <h2 id="faq-reading-heading">选校、学费、学多久？</h2>
    <p class="intro-copy">这类问题篇幅长一些，放在文章里更好读。</p>
    <ul class="faq-links">
      <li><a class="text-link" href="/articles/how-to-choose-nail-school/">美甲培训学校怎么挑？ <span aria-hidden="true">→</span></a></li>
      <li><a class="text-link" href="/articles/hangzhou-nail-training-price/">杭州美甲培训班学费一般多少？ <span aria-hidden="true">→</span></a></li>
      <li><a class="text-link" href="/articles/how-long-to-learn-nail/">零基础学美甲多久能学会？ <span aria-hidden="true">→</span></a></li>
      <li><a class="text-link" href="/articles/">浏览全部文章 <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>
  <section class="editorial-section" aria-labelledby="faq-contact-heading">
    <h2 id="faq-contact-heading">还有别的问题？</h2>
    <p class="intro-copy">写下来，整理成摘要带去沟通。</p>
    <div class="page-actions"><a class="button" href="/contact/">整理我的问题</a></div>
  </section>
</InnerPage>

<style>
  .faq-list { margin-top: 1rem; }
  .faq-item { border-top: 1px solid var(--line, #d9d1c4); }
  .faq-item:last-child { border-bottom: 1px solid var(--line, #d9d1c4); }
  summary { display: flex; align-items: center; gap: 1.5rem; min-height: 5rem; padding-block: 1.5rem; cursor: pointer; list-style: none; font-size: clamp(1.05rem, 1.8vw, 1.3rem); line-height: 1.6; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--ink, #232620); outline-offset: 4px; }
  .faq-number { color: var(--muted, #686258); font-size: calc(.8rem + 2px); letter-spacing: .1em; align-self: flex-start; margin-top: .3rem; }
  .faq-toggle { margin-left: auto; font-size: 1.6rem; font-weight: 300; }
  details[open] .faq-toggle { transform: rotate(45deg); }
  .faq-answer { padding: 0 3rem 2rem; max-width: 52rem; }
  .faq-answer p { line-height: 1.95; margin-top: 0; }
  .faq-links { display: grid; gap: 4px; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .faq-links .text-link { justify-content: space-between; max-width: 40rem; }
  @media (max-width: 640px) { summary { gap: 1rem; } .faq-answer { padding-inline: 2.2rem 0; } }
</style>
