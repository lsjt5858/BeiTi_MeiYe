---
import InnerPage from './_shared/InnerPage.astro';
import { getCourseOutline, getRetrainingPolicy } from '../lib/training.ts';
import { getServices } from '../lib/content.ts';
import { localeFromPath, localizedPath, translate } from '../lib/i18n.ts';
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const tr = (value: string) => translate(value, locale);
const href = (path: string) => localizedPath(path, locale);
const reference = getCourseOutline('nails')?.reference;
const retraining = getRetrainingPolicy();
const services = getServices().filter(service => service.price !== undefined);
const description = en
  ? 'Retraining venue fee: RMB 500. Foundation intensive: four days, RMB 1,980 in the 2025 course materials.'
  : '复训场地费500元。基础强化课程资料价：4天、1980元（2025版）。';
---
<InnerPage title={en ? 'Know what the fee covers.' : '费用，逐项说清。'} eyebrow="Pricing / 学费与复训" description={description} breadcrumbs={[{ label: '价格信息' }]}>
  <section class="editorial-section" aria-labelledby="current-fees-heading">
    <p class="eyebrow">CONFIRMED FEE</p>
    <h2 id="current-fees-heading">{en ? 'Retraining: RMB 500 venue fee' : '复训：500元场地费'}</h2>
    {retraining && <p class="intro-copy">{en ? 'Contact the campus in advance to book. ' : '请提前联系校区预约。'}{tr(retraining.booking)}</p>}
  </section>

  <section class="editorial-section" aria-labelledby="tuition-reference-heading">
    <p class="eyebrow">COURSE REFERENCE</p>
    <h2 id="tuition-reference-heading">{en ? 'Course reference price' : '课程资料价'}</h2>
    <div class="table-scroll" role="region" aria-label={en ? 'Course tuition reference' : '课程学费参考表'} tabindex="0">
      <table class="fact-table">
        <caption class="small-note">{en ? '2025 course reference. Ask the campus for current tuition and included items.' : '2025版课程资料价，当期学费及包含项请向校区咨询。'}</caption>
        <thead><tr><th scope="col">{en ? 'Course' : '课程'}</th><th scope="col">{en ? 'Duration' : '课期'}</th><th scope="col">{en ? 'Recorded fee' : '课件标价'}</th><th scope="col">{en ? 'Basis' : '价格口径'}</th></tr></thead>
        <tbody>
          {reference && <tr><th scope="row"><a class="text-link" href={href('/training/nails/')}>{tr(reference.name)}</a></th><td>{tr(reference.duration)}</td><td class="num">¥{reference.fee}</td><td>{en ? `${reference.year} deck reference` : `${reference.year}版课件参考`}</td></tr>}
          {services.map(service => <tr><th scope="row"><a class="text-link" href={href(`/services/${service.slug}/`)}>{tr(service.name)}</a></th><td>{tr(service.duration) || '—'}</td><td>{service.price}</td><td>{tr(service.unit) || '—'}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="small-note">{en ? 'For other classes, contact the campus for tuition and tool or materials arrangements.' : '其他课程的学费、工具与材料安排，请联系校区了解。'}</p>
    <div class="page-actions"><a class="button" href={href('/contact/')}>{en ? 'Ask about tuition' : '咨询课程费用'}</a><a class="text-link" href={href('/training/')}>{en ? 'Course content' : '查看课程内容'}</a></div>
  </section>
</InnerPage>
